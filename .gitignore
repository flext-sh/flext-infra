# TRACK: Beads team config; keep Dolt data, runtime state, and JSONL exports local.
!.beads/
.beads/*
!.beads/config.yaml
!.beads/metadata.json
!.beads/identity.toml

# mise native dependency graphs
!/.mise/
/.mise/*
!/.mise/locks/
!/.mise/locks/**
/.mise/locks/*.local/
/mise*.local.lock
/.mise*.local.lock

# BLOCK: AI/Agent Local Data (NEVER track these)
.claude/local/
.claude/history/
.claude/todos/
.claude/statsig/
.claude/projects/
.claude/shell-snapshots/
.claude/worktrees/
.claude/settings.local.json.bak
.trigger-tree/

# WHITELIST: Governed agent projections (every repository role)
!.agents/
!.agents/**

# Skill scan reports (transient, regenerated by skill_validate.py)
.agents/skills/*/report.json

# Agent hooks and machine-local config (runtime state, never source)
.github/hooks/
*/.hooks.json.agents-governance.json
.claude/*.agents-governance.json
.gemini/*.agents-governance.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Private local config layers
/config/*.local.yaml

# Host command policy projection (runtime state, never source)
/.moat/policy.yaml
# END ai-hub projection destinations
