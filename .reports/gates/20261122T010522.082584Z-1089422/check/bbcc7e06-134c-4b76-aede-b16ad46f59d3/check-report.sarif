          "ruleId": "ban-silent-failure-sentinel",
          "level": "error",
          "message": {
            "text": "A failure path collapses into a sentinel: unwrap_or(<sentinel>), a broad except that neither re-raises nor returns a failure, or an except / result guard branch that returns None, a boolean or an empty collection. Return the typed failure or let the exception escape."
          },
          "locations": [
