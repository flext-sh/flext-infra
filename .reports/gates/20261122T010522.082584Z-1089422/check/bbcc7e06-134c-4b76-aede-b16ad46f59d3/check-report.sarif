        {
          "ruleId": "ban-test-import-outside-test-namespace",
          "level": "error",
          "message": {
            "text": "Authored test imports a first-party namespace directly. Import the public name from the generated `tests` namespace instead; `tests/_<base>/*.py` is the only test-only implementation layer allowed to read first-party namespaces."
          },
          "locations": [
