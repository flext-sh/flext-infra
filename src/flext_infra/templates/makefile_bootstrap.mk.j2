{% from "project/base/tool_bootstrap_recipe.j2" import tool_bootstrap_recipe -%}
# Consume only generated topology facts; directory walking is forbidden.
ifeq ($(strip $(MAKE_PROFILE)),)
$(error MAKE_PROFILE is required; regenerate this Makefile from the topology SSOT)
endif
ifeq ($(strip $(WORKSPACE_ROOT_REL)),)
$(error WORKSPACE_ROOT_REL is required; regenerate this Makefile from the topology SSOT)
endif
ifneq ($(filter $(MAKE_PROFILE),workspace-root workspace-member standalone),$(MAKE_PROFILE))
$(error unsupported generated MAKE_PROFILE '$(MAKE_PROFILE)')
endif

ifneq ($(MAKE_PROFILE),standalone)
FLEXT_WORKSPACE_ROOT := $(abspath $(CURDIR)/$(WORKSPACE_ROOT_REL))
FLEXT_INFRA_BASE_MK := $(FLEXT_WORKSPACE_ROOT)/flext-infra/base.mk
ifeq ($(wildcard $(FLEXT_WORKSPACE_ROOT)/config/workspace.yaml),)
$(error generated workspace root lacks config/workspace.yaml: $(FLEXT_WORKSPACE_ROOT))
endif
ifeq ($(wildcard $(FLEXT_INFRA_BASE_MK)),)
$(error generated workspace root lacks flext-infra/base.mk: $(FLEXT_INFRA_BASE_MK))
endif
include $(FLEXT_INFRA_BASE_MK)
else
# =============================================================================
# STANDALONE BOOTSTRAP — auto-generates base.mk via flext-infra
# =============================================================================
# GNU Make auto-rebuild: if base.mk is missing, Make builds this target first,
# then restarts with base.mk loaded. All standard verbs become available.
# =============================================================================

SETUP_ROOT := $(shell git rev-parse --show-toplevel)
SETUP_BRANCH := $(shell git rev-parse --abbrev-ref HEAD)
SETUP_VENV := $(SETUP_ROOT)/.venv
MISE_DATA_DIR := $(SETUP_ROOT)/.tools
SETUP_MISE_VERSION := {{ mise_version }}
SETUP_MISE ?= mise
ifeq ($(OS),Windows_NT)
SETUP_PYTHON := $(SETUP_VENV)/Scripts/python.exe
else
SETUP_PYTHON := $(SETUP_VENV)/bin/python
endif
SETUP_UV ?= uv
SETUP_UV_ENV := env -u VIRTUAL_ENV -u UV_PROJECT -u UV_PROJECT_ENVIRONMENT \
	UV_PROJECT="$(SETUP_ROOT)" UV_PROJECT_ENVIRONMENT="$(SETUP_VENV)"
FLEXT_INFRA_BASEMK_GROUP := {{ make.CLI_GROUP_BASEMK }}

-include base.mk

.PHONY: setup venv

{{ tool_bootstrap_recipe("_bootstrap_setup_tools", "$(SETUP_MISE)", "$(MISE_DATA_DIR)", "$(SETUP_MISE_VERSION)", "$(SETUP_UV)") }}

.PHONY: _setup_require_safe_branch _bootstrap_setup_submodules

# Git refnames allow characters the shell parses ($ ; ` and whitespace), and
# SETUP_BRANCH comes from `git rev-parse --abbrev-ref HEAD` — i.e. from whoever
# named the branch. Validate it against a strict allowlist BEFORE any recipe
# interpolates it into a command, so a hostile branch name cannot execute.
_setup_require_safe_branch:
	@branch="$(SETUP_BRANCH)"; \
	if [ -z "$$branch" ] || [ "$$branch" = HEAD ]; then \
		echo "ERROR: setup requires a named git branch" >&2; exit 1; \
	fi; \
	case "$$branch" in \
		*[!a-zA-Z0-9._/-]*) \
			echo "ERROR: refusing unsafe branch name: $$branch" >&2; exit 1 ;; \
	esac

_bootstrap_setup_submodules: _setup_require_safe_branch
	@set -eu; \
	root="$(SETUP_ROOT)"; \
	cd "$$root"; \
	if [ ! -f "$$root/.gitmodules" ]; then exit 0; fi; \
	git submodule update --init --recursive; \
	test -z "$$(git status --porcelain)"; \
	git submodule status | while IFS= read -r line; do \
		state=$${line%% *}; \
		path=$${line#* }; \
		path=$${path%% *}; \
		case "$$state" in -*) continue ;; esac; \
		checkout="$$root/$$path"; \
		sha1=$$(git rev-parse "HEAD:$$path"); \
		cd "$$checkout"; \
		test "$$(git rev-parse HEAD)" = "$$sha1"; \
		if ! git rev-parse --verify --quiet "refs/heads/$(SETUP_BRANCH)" >/dev/null; then \
			git checkout --quiet -b "$(SETUP_BRANCH)"; \
		fi; \
	done

venv: _bootstrap_setup_tools ## Create the checkout-local virtual environment from the lock
	@$(SETUP_UV_ENV) "$(SETUP_UV)" sync --project "$(SETUP_ROOT)" --all-extras --all-groups

setup: _setup_require_safe_branch _bootstrap_setup_tools _bootstrap_setup_submodules ## Create the complete locked environment
	@$(SETUP_UV_ENV) "$(SETUP_UV)" sync --project "$(SETUP_ROOT)" --all-extras --all-groups
	@$(SETUP_PYTHON) -m flext_infra $(FLEXT_INFRA_BASEMK_GROUP) generate \
		--project-name $(PROJECT_NAME) --output base.mk
	@test -s base.mk || { echo "ERROR: base.mk generation failed"; exit 1; }
	@echo "==> Setup complete: local .venv and submodules on $(SETUP_BRANCH)."

ifeq ("$(wildcard base.mk)", "")
.PHONY: help

help: ## Show available commands
	@echo "================================================"
	@echo "  $(PROJECT_NAME) (standalone bootstrap)"
	@echo "================================================"
	@echo ""
	@echo "Bootstrap targets (no base.mk required):"
{% for verb_name, verb_help in make.STANDALONE_BOOTSTRAP_VERBS %}
	@printf "  %-14s %s\n" "{{ verb_name }}" "{{ verb_help }}"
{% endfor %}
	@echo ""
	@echo "After 'make setup', all standard verbs become available:"
	@echo "  {{ make.STANDALONE_POST_SETUP_VERBS }}"
	@echo ""
	@echo "Run 'make setup' first, then 'make help' for full verb list."
endif
endif
