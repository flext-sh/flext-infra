# Detect a FLEXT workspace root by its manifest and canonical base.mk owner.
FLEXT_WORKSPACE_ROOT := $(shell \
	current="$(CURDIR)"; \
	while [ "$$current" != "/" ]; do \
		if [ -f "$$current/.gitmodules" ] && [ -f "$$current/flext-infra/base.mk" ]; then echo "$$current"; break; fi; \
		current="$$(dirname "$$current")"; \
	done)

ifneq ($(FLEXT_WORKSPACE_ROOT),)
FLEXT_INFRA_BASE_MK := $(FLEXT_WORKSPACE_ROOT)/flext-infra/base.mk
include $(FLEXT_INFRA_BASE_MK)
else
# =============================================================================
# STANDALONE BOOTSTRAP — auto-generates base.mk via flext-infra
# =============================================================================
# GNU Make auto-rebuild: if base.mk is missing, Make builds this target first,
# then restarts with base.mk loaded. All standard verbs become available.
# =============================================================================

BOOTSTRAP_VENV := .venv
BOOTSTRAP_PYTHON := $(BOOTSTRAP_VENV)/bin/python
MISE := $(shell command -v mise 2>/dev/null)
UV_VERSION := {{ uv_version }}
UV = $(if $(MISE),$(MISE),$(error mise executable not found on caller PATH)) exec uv@$(UV_VERSION) -- uv
FLEXT_INFRA_BASEMK_GROUP := {{ make.CLI_GROUP_BASEMK }}
FLEXT_INFRA_DEPS_GROUP := {{ make.CLI_GROUP_DEPS }}

-include base.mk

base.mk: Makefile
	@echo "==> Resolving base.mk for $(PROJECT_NAME)..."
	@$(MAKE) --no-print-directory _bootstrap-venv
	@$(BOOTSTRAP_PYTHON) -m flext_infra $(FLEXT_INFRA_BASEMK_GROUP) generate \
		--project-name $(PROJECT_NAME) --output $@
	@test -s $@ || { echo "ERROR: base.mk generation failed"; rm -f $@; exit 1; }
	@echo "==> base.mk generated. Restarting make..."

# Bootstrap-only recipes: defined ONLY while base.mk is absent. Once base.mk
# exists it is -included above and the project's own custom.mk provides the
# real setup/venv targets; keeping these here too would make GNU make warn
# "overriding recipe for target 'setup'/'venv'/'_bootstrap-venv'".
ifeq ("$(wildcard base.mk)", "")
.PHONY: _bootstrap-venv venv setup

_bootstrap-venv:
	@venv="$(BOOTSTRAP_VENV)"; if [ -e "$$venv" ] || [ -L "$$venv" ]; then if [ ! -x "$(BOOTSTRAP_PYTHON)" ]; then archive="$$venv.invalid.$$(date -u +%Y%m%dT%H%M%SZ)"; mv "$$venv" "$$archive" || exit 2; echo "Archived invalid environment: $$archive"; fi; fi; env -u PYTHONPATH -u MYPYPATH -u VIRTUAL_ENV -u UV_PROJECT -u UV_PROJECT_ENVIRONMENT UV_PROJECT="$(CURDIR)" UV_PROJECT_ENVIRONMENT="$(CURDIR)/$(BOOTSTRAP_VENV)" $(UV) sync --project "$(CURDIR)" --all-extras --all-groups; test -x "$(BOOTSTRAP_PYTHON)"

venv: _bootstrap-venv ## Create standalone virtual environment
	@echo "Virtual environment ready at $(BOOTSTRAP_VENV)"

setup: venv ## Full standalone setup (venv + dependencies + base.mk)
	@$(BOOTSTRAP_PYTHON) -m flext_infra $(FLEXT_INFRA_DEPS_GROUP) extra-paths \
		--apply \
		--workspace "$(CURDIR)"
	@if git rev-parse --git-dir >/dev/null 2>&1; then \
		$(UV) run --project "$(CURDIR)" --no-sync pre-commit install; \
	fi
	@$(BOOTSTRAP_PYTHON) -m flext_infra $(FLEXT_INFRA_BASEMK_GROUP) generate \
		--project-name $(PROJECT_NAME) --output base.mk
	@echo "==> Setup complete. All 'make' verbs now available."
endif

ifeq ("$(wildcard base.mk)", "")
.PHONY: help

help: ## Show available commands
	@echo "================================================"
	@echo "  $(PROJECT_NAME) (standalone bootstrap)"
	@echo "================================================"
	@echo ""
	@echo "Bootstrap targets (no base.mk required):"
{% for verb_name, verb_help in make.STANDALONE_BOOTSTRAP_VERBS %}
	@printf "  %-14s %s\n" "{{ verb_name }}" "{{ verb_help }}"
{% endfor %}
	@echo ""
	@echo "After 'make setup', all standard verbs become available:"
	@echo "  {{ make.STANDALONE_POST_SETUP_VERBS }}"
	@echo ""
	@echo "Run 'make setup' first, then 'make help' for full verb list."
endif
endif
