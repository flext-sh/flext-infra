# === SECTION: derived paths (managed) ===
# Source: computed (git rev-parse, pwd, abspath)
PROJECT_ROOT := $(shell pwd -P)
override export FLEXT_PYTEST_TARGET_RAW := tests
SELF_MAKEFILE := $(abspath $(firstword $(MAKEFILE_LIST)))
