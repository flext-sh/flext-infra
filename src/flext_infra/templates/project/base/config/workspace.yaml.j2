# Generated initially by `flext-infra codegen new`; this manifest is the
# handwritten topology SSOT consumed by `flext-infra codegen conform`.
# Conform never overwrites it. Add members or exclusions here, then run make gen.
{% macro repository_fields(repository, indent) %}
{{ indent }}name: {{ repository.name | tojson }}
{{ indent }}distribution: {{ repository.distribution | tojson }}
{{ indent }}provider: {{ repository.provider | tojson }}
{{ indent }}branch: {{ repository.branch | tojson }}
{{ indent }}url: {{ repository.url | tojson }}
{{ indent }}path: {{ repository.path | tojson }}
{{ indent }}role: {{ repository.role | tojson }}
{{ indent }}state: {{ repository.state | tojson }}
{{ indent }}checkout: {{ repository.checkout | tojson }}
{{ indent }}codegen: {{ repository.codegen | tojson }}
{{ indent }}package: {{ repository.package | tojson }}
{{ indent }}editable: {{ repository.editable | tojson }}
{{ indent }}read_only: {{ repository.read_only | tojson }}
{% if repository.extra_verbs %}
{{ indent }}extra_verbs:
{% for verb in repository.extra_verbs %}
{{ indent }}  - name: {{ verb.name | tojson }}
{{ indent }}    operation: {{ verb.operation | tojson }}
{{ indent }}    handlers:
{% for handler in verb.handlers %}
{{ indent }}      - what: {{ handler.what | tojson }}
{% if handler.default %}
{{ indent }}        default: true
{% endif %}
{% if handler.apply_policy != "never" %}
{{ indent }}        apply_policy: {{ handler.apply_policy | tojson }}
{% endif %}
{% if handler.apply_default %}
{{ indent }}        apply_default: true
{% endif %}
{% if handler.required_inputs %}
{{ indent }}        required_inputs: {{ handler.required_inputs | tojson }}
{% endif %}
{% if handler.workflow %}
{{ indent }}        workflow:
{{ indent }}          order: {{ handler.workflow.order }}
{{ indent }}          contexts: {{ handler.workflow.contexts | tojson }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% if repository.script_dispatch %}
{{ indent }}script_dispatch:
{{ indent }}  dispatcher: {{ repository.script_dispatch.dispatcher | tojson }}
{% endif %}
{% endmacro %}
version: {{ workspace_manifest_version }}
name: {{ dist | tojson }}
repository:
{{ repository_fields(workspace_repository, "  ") }}
project:
  package_name: {{ package_name | tojson }}
  class_stem: {{ class_stem | tojson }}
  namespace: {{ ns | tojson }}
  constant_name: {{ const_name | tojson }}
  namespace_attribute: {{ ns_attr | tojson }}
  alias: {{ alias | tojson }}
  environment_prefix: {{ env_prefix | tojson }}
  description: {{ description | tojson }}
  version: {{ version | tojson }}
  license: {{ license | tojson }}
  author_name: {{ author_name | tojson }}
  author_email: {{ author_email | tojson }}
  upstream: {{ upstream | tojson }}
  homepage: {{ homepage | tojson }}
  documentation: {{ documentation | tojson }}
  year: {{ year }}
{% if workspace_repositories %}
members:
{% for repository in workspace_repositories %}
  -
{{ repository_fields(repository, "    ") }}
{% endfor %}
{% else %}
members: []
{% endif %}
{% if workspace_policy_overlays %}
repository_policy_overlays:
{% for overlay in workspace_policy_overlays %}
  - project: {{ overlay.project | tojson }}
    beads_enabled: {{ overlay.beads_enabled | tojson }}
    ci_enabled: {{ overlay.ci_enabled | tojson }}
{% endfor %}
{% else %}
repository_policy_overlays: []
{% endif %}
{% if workspace_exclusions %}
exclusions:
{% for exclusion in workspace_exclusions %}
  - path: {{ exclusion.path | tojson }}
    reason: {{ exclusion.reason | tojson }}
{% endfor %}
{% else %}
exclusions: []
{% endif %}
