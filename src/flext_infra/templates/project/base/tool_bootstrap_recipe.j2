{#- Native tool bootstrap: mise self-manages and uv owns locks.

    `mise install` provisions every declared tool from the committed mise.lock
    (locked mode); `make upg` alone resolves (`mise lock --bump`), the uv
    resolution living in the upg lifecycle. The lifecycle receives the
    resolved tool identities as environment. -#}
{% macro tool_bootstrap_recipe(target, project_root, mise, uv_version, lifecycle, bootstrap, make) -%}
.PHONY: {{ target }}
{{ target }}: _builtin_require_mise_pin
	@set -eu; \
	mise -C "{{ project_root }}" install --yes; \
	export SETUP_PYTHON="$$(mise which python)"; \
	export SETUP_DIRENV="$$(mise which direnv)"; \
	{{ lifecycle }}
{%- endmacro %}
{% macro mise_runtime_command(root, mise, bootstrap) -%}
exec{% endmacro %}
