{#- The official installer owns initial acquisition, including platform and
    checksum handling. Mise then reads its own lock and provisions the explicit
    declared tools; neither Make nor CI interprets lock or release formats. -#}
{% macro mise_acquisition(project_root, toolchain) -%}
	bootstrap_stage=acquisition; \
	if [ -L "{{ project_root }}/.bin" ] && [ ! -e "{{ project_root }}/.bin" ]; then rm -f "{{ project_root }}/.bin"; fi; mkdir -p "{{ project_root }}/.bin"; \
	export MISE_INSTALL_FROM_GITHUB=1 MISE_INSTALL_SKIP_IF_EXISTS=1 MISE_INSTALL_HELP=0; \
{% if toolchain.mise_version == "latest" %}	unset MISE_VERSION; \
	mise_acquired=false; \
{% else %}	export MISE_VERSION="{{ toolchain.mise_version }}"; \
	{#- The declared version is the gate: a present binary reporting exactly
	    it needs no installer download, so a no-op setup needs no network. #}
	mise_acquired=false; \
	if [ -x "$(BOOTSTRAP_MISE)" ]; then \
		mise_present="$$("$(BOOTSTRAP_MISE)" --version)"; \
		if [ "$${mise_present%% *}" = "$${MISE_VERSION}" ]; then mise_acquired=true; fi; \
	fi; \
{% endif %}	if [ "$${mise_acquired}" = true ]; then \
		printf 'setup: mise %s already acquired at %s\n' "$${MISE_VERSION}" "$(BOOTSTRAP_MISE)"; \
	else \
	case "$${OS:-}" in \
		(Windows_NT) \
			export MISE_INSTALL_PATH="$$(cygpath --windows "$(BOOTSTRAP_MISE)")"; \
			powershell.exe -NoProfile -Command '$$ErrorActionPreference = "Stop"; Invoke-RestMethod https://mise.run/powershell | Invoke-Expression' ;; \
		(*) \
			export MISE_INSTALL_PATH="$(BOOTSTRAP_MISE)"; \
			mise_stage="$$(mktemp -d "{{ project_root }}/.bin/.mise-install.XXXXXXXX")"; \
			curl --proto '=https' --tlsv1.2 -fsSL -o "$${mise_stage}/install.sh" https://mise.run; \
			sh "$${mise_stage}/install.sh" ;; \
	esac; \
	fi;
{%- endmacro %}

{% macro mise_staging_cleanup() -%}
		if [ -n "$${mise_stage}" ]; then \
			if rm -rf "$${mise_stage}"; then :; else \
				mise_cleanup_status=$$?; \
				printf "ERROR: bootstrap staging cleanup failed (exit %s); original exit %s\n" "$${mise_cleanup_status}" "$${bootstrap_status}" >&2; \
				if [ "$${bootstrap_status}" -eq 0 ]; then bootstrap_status=$${mise_cleanup_status}; fi; \
			fi; \
		fi;
{%- endmacro %}

{% macro mise_network_admission() -%}
	bootstrap_stage=network-auth; \
	if git config --global --get-regexp '^url\.https?://[^ /]+:[^ /]+@.*\.insteadof$$' >/dev/null; then \
		printf 'ERROR: Global Git URL rewrite configuration embeds credentials and shadows the fleet SSH route; correct that configuration at its owner\n' >&2; \
		exit 2; \
	else \
		rewrite_status=$$?; \
		if [ "$$rewrite_status" -ne 1 ]; then \
			printf 'ERROR: Cannot inspect the global Git URL rewrite configuration\n' >&2; \
			exit "$$rewrite_status"; \
		fi; \
	fi;
{%- endmacro %}

{#- One lock resolution per project (ADR-030): each governed member forms its
    own uv.lock, then this project, whose lock is their composition. Only
    ``upgrade`` moves the pins a lock already holds; without it a changed
    declaration resolves and every existing pin stays. -#}
{% macro uv_lock_resolution(upgrade) -%}
	{{ mise_network_admission() }} \
	mise_bin="$(MISE)"; \
	$(RESOLVE_DESIRED_PYTHON); \
	set -f; \
	$(GOVERNED_CHECKOUTS); \
	for checkout in $$checkouts; do \
		case "$$checkout" in .) continue ;; esac; \
		[ ! -f "$$root/$$checkout/pyproject.toml" ] || \
			$(UV) lock{{ " --upgrade" if upgrade }} --project "$$root/$$checkout" --python "$$desired_python" --no-python-downloads; \
	done; \
	set +f; \
	$(UV) lock{{ " --upgrade" if upgrade }} --project "$(PROJECT_ROOT)" --python "$$desired_python" --no-python-downloads;
{%- endmacro %}

{#- Native installation preserves valid pins. Setup fills absent lock entries;
    upgrade installs the exact pins its preceding resolution published. -#}
{% macro mise_install(project_root, install_tools, locked=true) -%}
	export MISE_SHIMS_DIR="{{ project_root }}/.bin/shims"; \
	export MISE_LOCKED={{ "1" if locked else "0" }}; \
	bootstrap_stage=tool-install; \
	"$(BOOTSTRAP_MISE)" -C "{{ project_root }}" install --yes{% for tool in install_tools %} "{{ tool }}"{% endfor %};
{%- endmacro %}

{#- Setup acquires the declared Mise and lets its native installer complete
    incomplete lock inputs before the runtime reader consumes them. -#}
{% macro mise_toolchain_provision(project_root, toolchain, install_tools) -%}
{{ mise_acquisition(project_root, toolchain) }} \
	{{ mise_install(project_root, install_tools, locked=false) }}
{%- endmacro %}

{#- Syntax preflight of one committed TOML lock (a projection never
    merge-resolved by hand). The reader is the acquired Mise's own TOML parser
    (`mise fmt --stdin`), which depends on no lock, so even a corrupt mise.lock
    is classified before anything installs from it. The reader first proves
    itself on an empty document; then exit 1 on the lock classifies it as
    invalid TOML: it is deleted so its native writer, which runs next in the
    same upgrade, regenerates it in full. Any other failure stops the upgrade. -#}
{% macro toml_projection_preflight(reader, lock_path) -%}
if [ -f {{ lock_path }} ]; then \
		"{{ reader }}" fmt --stdin < /dev/null >/dev/null; \
		if "{{ reader }}" fmt --stdin < {{ lock_path }} >/dev/null; then :; else \
			lint_status=$$?; \
			if [ "$$lint_status" -ne 1 ]; then exit "$$lint_status"; fi; \
			printf 'upg: %s is not valid TOML; deleting it so its native writer regenerates it\n' {{ lock_path }}; \
			rm -f {{ lock_path }}; \
		fi; \
	fi;
{%- endmacro %}

{#- Native changed-tool Mise relock of one governed repository. `mise lock
    --bump --dry-run --json` prints exactly `[]` when no locked version would
    change (a documented native result compared for equality, never parsed).
    Otherwise each declared tool previews alone and only the tools whose own
    preview is not `[]` are locked, so provenance artifacts are fetched for
    the changed tools only. A change no declared tool owns is the removal of
    entries for tools the configuration no longer declares: the native whole
    `mise lock` (no `--bump`, locked versions kept) prunes them, and a preview
    still not `[]` afterwards stops the upgrade. -#}
{% macro mise_lock_changed(mise, lock_root, install_tools) -%}
if [ "$$("{{ mise }}" -C {{ lock_root }} lock --bump --dry-run --json)" = "[]" ]; then \
		printf 'upg: %s: no locked version changes\n' {{ lock_root }}; \
	else \
		changed_tools=""; \
		for tool in{% for tool in install_tools %} "{{ tool }}"{% endfor %}; do \
			if [ "$$("{{ mise }}" -C {{ lock_root }} lock --bump --dry-run --json "$$tool")" != "[]" ]; then changed_tools="$$changed_tools $$tool"; fi; \
		done; \
		if [ -z "$$changed_tools" ]; then \
			printf 'upg: %s: pruning lock entries no declared tool owns\n' {{ lock_root }}; \
			"{{ mise }}" -C {{ lock_root }} lock; \
			if [ "$$("{{ mise }}" -C {{ lock_root }} lock --bump --dry-run --json)" != "[]" ]; then \
				printf 'ERROR[upg] %s: mise still previews a lock change that no declared tool owns\n' {{ lock_root }} >&2; \
				exit 2; \
			fi; \
		else \
			printf 'upg: %s: locking%s\n' {{ lock_root }} "$$changed_tools"; \
			"{{ mise }}" -C {{ lock_root }} lock --bump $$changed_tools; \
		fi; \
	fi;
{%- endmacro %}

{% macro tool_bootstrap_recipe(target, project_root, toolchain, install_tools, lifecycle, make, report_literal, report_relative_path) -%}
{% set mise_selector = toolchain.mise_selector -%}
.PHONY: {{ target }}

# The lifecycle invokes recursive make through mise, so preserve jobserver FDs.
{{ target }}:
	+@set -eu; \
	bootstrap_stage=source-identity; bootstrap_completed=false; bootstrap_sha=null; bootstrap_git_status=null; mise_stage=; \
	bootstrap_report="{{ project_root }}/{{ report_relative_path }}"; \
	bootstrap_publish_report() { \
		if [ -d "$$(dirname "$${bootstrap_report}")" ]; then :; else mkdir -p "$$(dirname "$${bootstrap_report}")" 2>/dev/null || true; fi; \
		if printf '%s\n' {{ report_literal }} | sed \
			-e "s/@@SHA@@/$${bootstrap_sha}/" \
			-e "s/@@GIT_EXIT@@/$${bootstrap_git_status}/" \
			-e "s/@@EXIT@@/$${bootstrap_status}/" \
			-e "s/@@STAGE@@/$${bootstrap_stage}/" \
			-e "s/@@COMPLETE@@/$${bootstrap_completed}/" > "$${bootstrap_report}.pending"; then :; else return $$?; fi; \
		mv "$${bootstrap_report}.pending" "$${bootstrap_report}"; \
	}; \
	trap 'bootstrap_status=$$?; trap - EXIT; \
		{{ mise_staging_cleanup() }} \
		if bootstrap_publish_report; then :; else \
			bootstrap_report_status=$$?; \
			printf "ERROR: bootstrap evidence publication failed (exit %s); original exit %s\n" "$${bootstrap_report_status}" "$${bootstrap_status}" >&2; \
			if [ "$${bootstrap_status}" -eq 0 ]; then bootstrap_status=$${bootstrap_report_status}; fi; \
		fi; \
		exit "$${bootstrap_status}"' EXIT; \
	if bootstrap_candidate="$$(git -C "{{ project_root }}" rev-parse --verify HEAD)"; then \
		bootstrap_git_status=0; \
		case "$${bootstrap_candidate}" in \
			*[!0-9a-f]*) printf 'ERROR: bootstrap candidate is not a Git object ID\n' >&2; exit 2 ;; \
		esac; \
		case "{% raw %}$${#bootstrap_candidate}{% endraw %}" in \
			40|64) bootstrap_sha="\"$${bootstrap_candidate}\"" ;; \
			*) printf 'ERROR: bootstrap candidate has an invalid object ID length\n' >&2; exit 2 ;; \
		esac; \
	else bootstrap_git_status=$$?; fi; \
	{{ mise_network_admission() }} \
	{{ mise_toolchain_provision(project_root, toolchain, install_tools) }} \
	mise_active="$$("$(BOOTSTRAP_MISE)" -C "{{ project_root }}" tool "{{ mise_selector }}" --active)"; \
	mise_binary="$$("$(BOOTSTRAP_MISE)" -C "{{ project_root }}" which mise)"; \
	if [ "$${OS:-}" = Windows_NT ]; then mise_binary="$$(cygpath --unix "$${mise_binary}")"; fi; \
	{#- A hosted runner hands later steps only the GITHUB_PATH entries. They are
	    the installed tool directories, as the local activation (.envrc) puts
	    them on PATH; a shim resolves its version from the caller's working
	    directory, so a tool run outside the checkout found none (flext-cli CI
	    run 42473521346: "No version is set for shim: taplo"). #}
	bootstrap_stage=tool-paths; \
	if [ -n "$${GITHUB_PATH:-}" ]; then "$${mise_binary}" -C "{{ project_root }}" bin-paths >> "$${GITHUB_PATH}"; fi; \
	printf 'setup: mise %s provisioning complete\n' "$${mise_active}"; \
	printf 'setup: entering lifecycle (submodules, environment, hooks) make=%s\n' "$(SELF_MAKE_EXECUTABLE)"; \
	bootstrap_stage=lifecycle; \
	MISE_AUTO_INSTALL=0 "$${mise_binary}" -C "{{ project_root }}" exec -- env "{{ make.ci.variable }}=$({{ make.ci.variable }})" {{ lifecycle }}; \
	bootstrap_stage=complete; bootstrap_completed=true
{%- endmacro %}
