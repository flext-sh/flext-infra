{% macro tool_bootstrap_recipe(target, mise, mise_data_dir, mise_version, uv) -%}
.PHONY: {{ target }}

{{ target }}:
	@set -eu; \
	command -v "{{ mise }}" >/dev/null 2>&1 || { \
		printf 'ERROR: make setup requires mise %s; install it before setup\n' "{{ mise_version }}" >&2; \
		exit 2; \
	}; \
	current=$$("{{ mise }}" --version 2>/dev/null | cut -d ' ' -f 1); \
	[ "$$current" = "{{ mise_version }}" ] || { \
		printf 'ERROR: mise version mismatch: expected %s, got %s\n' "{{ mise_version }}" "$$current" >&2; \
		exit 2; \
	}; \
	command -v "{{ uv }}" >/dev/null 2>&1 || { \
		printf 'ERROR: make setup requires uv >= 0.11.0 in PATH\n' >&2; \
		exit 2; \
	}; \
	uv_version=$$("{{ uv }}" --version | sed 's/uv //' | cut -d ' ' -f 1); \
	[ "$$(printf '%s\n%s' '0.11.0' "$$uv_version" | sort -V | head -n1)" = '0.11.0' ] || { \
		printf 'ERROR: make setup requires uv >= 0.11.0, found %s\n' "$$uv_version" >&2; \
		exit 2; \
	}; \
	mkdir -p "{{ mise_data_dir }}"; \
	MISE_DATA_DIR="{{ mise_data_dir }}" "{{ mise }}" install --yes
{%- endmacro %}
