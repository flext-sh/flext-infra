{% macro test_report_recipe(
	runner,
	validator,
	default_target,
	coverage_default_target,
	profile_runner,
	command_prefix="@"
) %}
	{{ command_prefix }}_files="$(strip $(FILES))"; \
	if [ -n "$(FILE)" ]; then \
		case "$(FILE)" in /*|..|../*|*/../*|*/..) \
			printf 'ERROR: FILE must be a repository-relative path\n' >&2; exit 2 ;; \
		esac; \
		if [ -n "$$_files" ]; then _files="$$_files $(FILE)"; else _files="$(FILE)"; fi; \
	fi; \
	_pytest_run="{{ default_target }}"; \
	if [ -n "$$_files" ]; then _pytest_run="$$_files"; fi; \
	for target in $$_pytest_run; do \
		if [ ! -e "$$target" ]; then \
			printf 'ERROR: test target does not exist: %s\n' "$$target" >&2; exit 2; \
		fi; \
	done; \
	_all_pytest_args="$(PYTEST_ARGS)"; \
	if [ -n "$(MATCH)" ]; then _all_pytest_args="$$_all_pytest_args -k $(MATCH)"; fi; \
	if [ "$(FAIL_FAST)" = "1" ] || [ "$(FAIL_FAST)" = "{{ make.apply_value }}" ]; then \
		_all_pytest_args="$$_all_pytest_args -x"; \
	fi; \
	if [ "$(VERBOSE)" = "1" ]; then _all_pytest_args="$$_all_pytest_args -vv -s"; fi; \
	if [ -n "$${PYTEST_ADDOPTS:-}" ]; then \
		printf 'ERROR: PYTEST_ADDOPTS cannot override canonical pytest enforcement\n' >&2; \
		exit 2; \
	fi; \
	if [ -n "$${PYTEST_DISABLE_PLUGIN_AUTOLOAD:-}" ] || \
		[ -n "$${PYTEST_TIMEOUT:-}" ] || \
		[ -n "$${PYTEST_TIMEOUT_METHOD:-}" ] || \
		[ -n "$${PYTEST_TIMEOUT_FUNC_ONLY:-}" ]; then \
		printf 'ERROR: pytest policy environment overrides are forbidden\n' >&2; \
		exit 2; \
	fi; \
	case " $$_all_pytest_args " in \
		*" --timeout "*|*" --timeout="*|*" --session-timeout "*|\
		*" --session-timeout="*|*" --timeout-method "*|\
		*" --timeout-method="*|*" --timeout-disable "*|\
		*" --timeout-func-only "*|*" --override-ini "*|\
		*" --override-ini="*|*" -o "*|*" -c "*|*" -c="*|*" -c"?*|\
		*" --config-file "*|*" --config-file="*|\
		*" --disable-plugin-autoload "*|*" --disable-plugin-autoload="*|\
		*" -p no:timeout "*|*" -pno:timeout "*|*" -p=no:timeout "*|\
		*" -p no:$(PYTEST_ENFORCEMENT_PLUGIN) "*|\
		*" -pno:$(PYTEST_ENFORCEMENT_PLUGIN) "*|\
		*" -p=no:$(PYTEST_ENFORCEMENT_PLUGIN) "*) \
			printf 'ERROR: PYTEST_ARGS cannot override canonical pytest enforcement\n' >&2; \
			exit 2 ;; \
	esac; \
	case "$(PYTEST_CASE_TIMEOUT_SECONDS):$(PYTEST_RUN_TIMEOUT_SECONDS):$(PYTEST_TERMINATION_GRACE_SECONDS)" in \
		*[!0-9:]*|:*|*::*|*:) \
			printf 'ERROR: configured pytest time limits must be positive integers\n' >&2; \
			exit 2 ;; \
	esac; \
	if [ "$(PYTEST_CASE_TIMEOUT_SECONDS)" -le 0 ] || \
		[ "$(PYTEST_CASE_TIMEOUT_SECONDS)" -ge "$(PYTEST_RUN_TIMEOUT_SECONDS)" ] || \
		[ "$(PYTEST_TERMINATION_GRACE_SECONDS)" -le 0 ] || \
		[ "$(PYTEST_TERMINATION_GRACE_SECONDS)" -ge "$(PYTEST_RUN_TIMEOUT_SECONDS)" ]; then \
		printf 'ERROR: invalid pytest limits: case=%ss run=%ss grace=%ss\n' \
			"$(PYTEST_CASE_TIMEOUT_SECONDS)" "$(PYTEST_RUN_TIMEOUT_SECONDS)" \
			"$(PYTEST_TERMINATION_GRACE_SECONDS)" >&2; \
		exit 2; \
	fi; \
	command -v "$(PYTEST_TIMEOUT_COMMAND)" >/dev/null 2>&1 || { \
		printf 'ERROR: required executable not found: %s\n' "$(PYTEST_TIMEOUT_COMMAND)" >&2; exit 2; }; \
	command -v tee >/dev/null 2>&1 || { \
		printf 'ERROR: required executable not found: tee\n' >&2; exit 2; }; \
	run_id=$$(date -u +%Y%m%dT%H%M%SZ)-$$$$; \
	report_dir="$(PYTEST_REPORTS_DIR)/$$run_id"; \
	mkdir -p "$$report_dir"; \
	log_file="$$report_dir/pytest.log"; \
	junit_file="$$report_dir/junit.xml"; \
	coverage_file="$$report_dir/coverage.xml"; \
	summary_file="$$report_dir/summary.txt"; \
	failed_file="$$report_dir/failed-tests.txt"; \
	errors_file="$$report_dir/errors.txt"; \
	warnings_file="$$report_dir/warnings.txt"; \
	slowest_file="$$report_dir/slowest-tests.txt"; \
	skips_file="$$report_dir/skipped-tests.txt"; \
	command_file="$$report_dir/command.txt"; \
	status_file="$$report_dir/pytest.exit"; \
	profile_file="$$report_dir/profile.pstats"; \
	profile_report="$$report_dir/profile.txt"; \
	_coverage_args="--cov --cov-report=xml:$$coverage_file"; \
	_coverage_required=1; \
	_coverage_value="$$coverage_file"; \
	if [ -n "$$_files" ] || [ -n "$(MATCH)" ] || \
		[ "$$_pytest_run" != "{{ coverage_default_target }}" ]; then \
		_coverage_args="--no-cov"; \
		_coverage_required=0; \
		_coverage_value="not-generated"; \
	fi; \
	if [ "$(WHAT)" = "profile" ]; then \
		if [ -z "$(FILE)" ]; then \
			printf 'ERROR: make test WHAT=profile requires FILE=<nodeid-or-path>\n' >&2; exit 2; \
		fi; \
		_coverage_args="--no-cov"; \
		_coverage_required=0; \
		_coverage_value="not-generated"; \
		set -- {{ profile_runner }} -o "$$profile_file" -m pytest \
			$$_pytest_run $(PYTEST_REPORT_ARGS) \
			$(if $(filter 1,$(DIAG)),$(PYTEST_DIAG_ARGS),) \
			-p no:metadata -p timeout -p "$(PYTEST_ENFORCEMENT_PLUGIN)" \
			--junitxml="$$junit_file" $$_coverage_args $$_all_pytest_args \
			$(PYTEST_PROGRESS_ARGS) --timeout="$(PYTEST_CASE_TIMEOUT_SECONDS)" \
			--session-timeout="$(PYTEST_RUN_TIMEOUT_SECONDS)" -n0; \
	else \
		_parallel_args="-n $(PYTEST_PARALLEL_WORKERS) --dist $(PYTEST_PARALLEL_DISTRIBUTION)"; \
		if [ -n "$$_files" ] || [ -n "$(MATCH)" ]; then _parallel_args="-n0"; fi; \
		set -- {{ runner }} $$_pytest_run $(PYTEST_REPORT_ARGS) \
			$(if $(filter 1,$(DIAG)),$(PYTEST_DIAG_ARGS),) \
			-p no:metadata -p timeout -p "$(PYTEST_ENFORCEMENT_PLUGIN)" \
			--junitxml="$$junit_file" $$_coverage_args $$_all_pytest_args \
			$(PYTEST_PROGRESS_ARGS) --timeout="$(PYTEST_CASE_TIMEOUT_SECONDS)" \
			--session-timeout="$(PYTEST_RUN_TIMEOUT_SECONDS)" \
			$$_parallel_args; \
	fi; \
	printf '%s\n' "$$@" > "$$command_file"; \
	_soft_timeout_seconds=$$(( $(PYTEST_RUN_TIMEOUT_SECONDS) - $(PYTEST_TERMINATION_GRACE_SECONDS) )); \
	( \
		env -u PYTEST_ADDOPTS -u PYTEST_DISABLE_PLUGIN_AUTOLOAD \
			-u PYTEST_TIMEOUT -u PYTEST_TIMEOUT_METHOD \
			-u PYTEST_TIMEOUT_FUNC_ONLY PYTHONUNBUFFERED=1 \
			"$(PYTEST_TIMEOUT_COMMAND)" --signal=INT \
			--kill-after="$(PYTEST_TERMINATION_GRACE_SECONDS)s" \
			"$${_soft_timeout_seconds}s" "$$@"; \
		printf '%s\n' "$$?" > "$$status_file" \
	) 2>&1 | tee "$$log_file"; \
	tee_status=$$?; \
	if [ ! -s "$$status_file" ]; then \
		printf 'ERROR: pytest exit status was not recorded\n' >&2; \
		rc=125; \
	else \
		rc=$$(tr -dc '0-9' < "$$status_file"); \
		case "$$rc" in ''|*[!0-9]*) rc=125 ;; esac; \
	fi; \
	if [ "$$tee_status" -ne 0 ] && [ "$$rc" -eq 0 ]; then rc=$$tee_status; fi; \
	if [ "$(WHAT)" = "profile" ] && [ "$$rc" -eq 0 ]; then \
		if {{ validator }} cprofile-report --workspace "." \
			--profile "$$profile_file" --output "$$profile_report" \
			--sort "$(PYTEST_PROFILE_SORT)" --limit "$(PYTEST_PROFILE_LIMIT)"; then \
			:; \
		else \
			profile_status=$$?; \
			if [ "$$rc" -eq 0 ]; then rc=$$profile_status; fi; \
		fi; \
	fi; \
	printf '%s\n' "$$rc" > "$$status_file"; \
	if [ "$$rc" -eq "$(PYTEST_TIMEOUT_EXIT_CODE)" ] || [ "$$rc" -eq 137 ]; then \
		_coverage_required=0; \
		_coverage_value="invalid-timeout"; \
		printf 'ERROR: pytest invocation reached the configured hard wall %ss (exit=%s)\n' \
			"$(PYTEST_RUN_TIMEOUT_SECONDS)" "$$rc" | tee -a "$$log_file" >&2; \
	fi; \
	if [ "$$_coverage_required" -eq 1 ] && [ ! -s "$$coverage_file" ]; then \
		printf 'ERROR: coverage report was not generated or is empty: %s\n' \
			"$$coverage_file" >&2; \
		if [ "$$rc" -eq 0 ]; then rc=2; fi; \
	fi; \
	if [ -f "$$junit_file" ]; then \
		tests=$$(grep -Eo 'tests="[0-9]+"' "$$junit_file" | head -n 1 | tr -dc '0-9'); \
		failures=$$(grep -Eo 'failures="[0-9]+"' "$$junit_file" | head -n 1 | tr -dc '0-9'); \
		errors=$$(grep -Eo 'errors="[0-9]+"' "$$junit_file" | head -n 1 | tr -dc '0-9'); \
		skipped=$$(grep -Eo 'skipped="[0-9]+"' "$$junit_file" | head -n 1 | tr -dc '0-9'); \
		duration=$$(grep -Eo 'time="[0-9.]+"' "$$junit_file" | head -n 1 | sed -E 's/time="([0-9.]+)"/\1/'); \
		tests=$${tests:-0}; failures=$${failures:-0}; errors=$${errors:-0}; \
		skipped=$${skipped:-0}; duration=$${duration:-0}; \
		passed=$$((tests - failures - errors - skipped)); \
		if [ "$$passed" -lt 0 ]; then passed=0; fi; \
		printf 'junit=%s\ncoverage=%s\nexit_status=%s\ntotal=%s\npassed=%s\nfailed=%s\nerrors=%s\nskipped=%s\nduration_seconds=%s\n' \
			"$$junit_file" "$$_coverage_value" "$$status_file" "$$tests" "$$passed" \
			"$$failures" "$$errors" "$$skipped" "$$duration" > "$$summary_file"; \
	else \
		printf 'junit=not-generated\ncoverage=%s\nexit_status=%s\ntotal=0\npassed=0\nfailed=0\nerrors=0\nskipped=0\nduration_seconds=0\n' \
			"$$_coverage_value" "$$status_file" > "$$summary_file"; \
	fi; \
	counts_file="$$report_dir/counts.env"; \
	if {{ validator }} pytest-diag \
		--junit "$$junit_file" --log "$$log_file" \
		--case-timeout-seconds "$(PYTEST_CASE_TIMEOUT_SECONDS)" \
		--failed "$$failed_file" --errors "$$errors_file" \
		--warnings "$$warnings_file" --slowest "$$slowest_file" \
		--skips "$$skips_file" > "$$counts_file"; then \
		:; \
	else \
		counts_status=$$?; \
		printf 'ERROR: pytest diagnostic extraction failed (exit=%s)\n' \
			"$$counts_status" >&2; \
		cat "$$counts_file" >&2; \
		if [ "$$rc" -eq "$(PYTEST_TIMEOUT_EXIT_CODE)" ] || [ "$$rc" -eq 137 ]; then \
			printf 'failed_count=0\nerror_count=0\nwarning_count=0\nskipped_count=0\n' \
				> "$$counts_file"; \
		else \
			exit "$$counts_status"; \
		fi; \
	fi; \
	if ! awk ' \
		BEGIN { required["failed_count"]; required["error_count"]; required["warning_count"]; required["skipped_count"] } \
		$$0 !~ /^(failed_count|error_count|warning_count|skipped_count)=[0-9]+$$/ { invalid=1; next } \
		{ split($$0, fields, "="); if (seen[fields[1]]++) invalid=1 } \
		END { if (NR != 4) invalid=1; for (key in required) if (seen[key] != 1) invalid=1; exit invalid } \
	' "$$counts_file"; then \
		echo "ERROR: invalid pytest diagnostic counts contract" >&2; \
		cat "$$counts_file" >&2; \
		exit 2; \
	fi; \
	. "$$counts_file"; \
	if [ "$${failed_count:-0}" -gt 0 ] || [ "$${error_count:-0}" -gt 0 ] || \
		[ "$${warning_count:-0}" -gt 0 ] || [ "$${skipped_count:-0}" -gt 0 ]; then \
		if [ "$$rc" -eq 0 ]; then rc=1; fi; \
	fi; \
	if [ "$(DIAG)" = "1" ]; then \
		run_state=COMPLETED; \
		if [ "$$rc" -eq 130 ]; then run_state=INTERRUPTED; fi; \
		if [ "$$rc" -eq "$(PYTEST_TIMEOUT_EXIT_CODE)" ] || [ "$$rc" -eq 137 ]; then \
			run_state=TIMED_OUT; \
		fi; \
		printf 'DIAG %s | failed=%s errors=%s warnings=%s skipped=%s\n' \
			"$$run_state" "$$failed_count" "$$error_count" \
			"$$warning_count" "$$skipped_count" >&2; \
	fi; \
	ln -sfn "$$run_id" "$(PYTEST_REPORTS_DIR)/latest"; \
	printf 'Reports: %s (latest: %s/latest)\n' \
		"$$report_dir" "$(PYTEST_REPORTS_DIR)" >&2; \
	exit "$$rc"
{%- endmacro %}
