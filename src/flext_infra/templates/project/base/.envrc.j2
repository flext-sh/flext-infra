PROJECT_STATE_ROOT="${PROJECT_ROOT%/*}/{{ state_directory_name }}/${PROJECT_ROOT##*/}"
PROJECT_SCRATCH="${PROJECT_STATE_ROOT}/{{ scratch_namespace }}"
mkdir -p "${PROJECT_SCRATCH}"
if command -v chattr >/dev/null 2>&1 && [[ "$(stat -f -c %T "${PROJECT_SCRATCH}")" == "btrfs" ]]; then
