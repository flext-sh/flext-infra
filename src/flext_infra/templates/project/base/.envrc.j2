{% from "runtime_context_recipe.j2" import git_root_reader, bootstrap_root_reader, runtime_root_reader -%}
{% set uv_tool = toolchain.tools | selectattr("name", "equalto", "uv") | first %}
# Generated by `flext-infra codegen conform`.
# === SECTION: header (managed) ===
# Source: template (base/.envrc.j2)
# Free: no
# Canonical direnv activation for one inferred repository environment.
# End SECTION: header

# === SECTION: strict evaluation and watched inputs (managed) ===
# Source: template (direnv stdlib contract)
strict_env
# End SECTION: strict evaluation and watched inputs

# === SECTION: repository environment (managed) ===
# Source: computed:nearest-pyproject-via-direnv-find_up + template
PROJECT_ROOT="$(find_up pyproject.toml)" || return $?
case "${PROJECT_ROOT}" in
  /*) ;;
  *) printf 'ERROR: project discovery did not return an absolute manifest path: %s\n' "${PROJECT_ROOT}" >&2; return 2 ;;
esac
PROJECT_ROOT="${PROJECT_ROOT%/*}"
# Physical paths only: the Makefile resolves its roots with realpath and
# `pwd -P`, so a checkout entered through a symlink keeps one runtime path.
PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd -P)" || return $?
# The shared native reader authenticates Git scope and asks governed UV about
# membership. Activation observes the reader; it never provisions it.
GIT_DISCOVERY_ROOT="$( {{ git_root_reader('"${PROJECT_ROOT}"') }} )"
BOOTSTRAP_ROOT="$( {{ bootstrap_root_reader('"${PROJECT_ROOT}"') }} )"
RUNTIME_ROOT="$( {{ runtime_root_reader('"${PROJECT_ROOT}"', uv_tool, toolchain.mise_selector, native_environment_unset) }} )"
watch_file "${PROJECT_ROOT}/pyproject.toml"
watch_file "${RUNTIME_ROOT}/pyproject.toml"
watch_file "${RUNTIME_ROOT}/uv.lock"
watch_file "${RUNTIME_ROOT}/.mise.toml"
watch_file "${RUNTIME_ROOT}/mise.lock"
git_parent="$(cd "${GIT_DISCOVERY_ROOT}/.." && pwd -P)"
runtime_parent="$(cd "${RUNTIME_ROOT}/.." && pwd -P)"
export GIT_CEILING_DIRECTORIES="${git_parent}"
export MISE_CEILING_PATHS="${runtime_parent}"
# D-VENV: a member inside a workspace uses the workspace environment; a
# standalone checkout or a linked worktree owns its own physical environment
# inside the checkout. The location is law, never configuration: no
# environment is shared with another checkout or lives outside it.
VENV_DIR="${RUNTIME_ROOT}/{{ environment_directory }}"
for environment_path in "${VENV_DIR%/*}" "${VENV_DIR}" "${VENV_DIR}/bin" "${VENV_DIR}/Scripts" "${PROJECT_ROOT}/{{ environment_directory }}" "${PROJECT_ROOT}/{{ environment_directory }}/bin" "${PROJECT_ROOT}/{{ environment_directory }}/Scripts"; do
  if [[ -L "${environment_path}" ]]; then
    log_error "workspace environment must be physical, not a symlink: ${environment_path}"
    return 1
  fi
done
if [[ "${OS:-}" == Windows_NT ]]; then
  environment_bin="${VENV_DIR}/Scripts"
  bootstrap_mise="${BOOTSTRAP_ROOT}/.bin/mise.exe"
  environment_python="${environment_bin}/python.exe"
else
  environment_bin="${VENV_DIR}/bin"
  bootstrap_mise="${BOOTSTRAP_ROOT}/.bin/mise"
  environment_python="${environment_bin}/python"
fi
if [[ ! -x "${environment_python}" ]]; then
  log_error "workspace interpreter is not provisioned: ${environment_python}; run make setup"
  return 1
fi
readonly PROJECT_ROOT BOOTSTRAP_ROOT RUNTIME_ROOT VENV_DIR environment_bin environment_python bootstrap_mise git_parent runtime_parent
export PROJECT_ROOT RUNTIME_ROOT
export PYTHON_KEYRING_BACKEND="keyring.backends.null.Keyring"
export PYTHONUNBUFFERED=1
# End SECTION: repository environment

# === SECTION: local overrides (managed) ===
# Source: existing local settings; physical ownership is not an override.
source_env_if_exists "${PROJECT_ROOT}/.envrc.local"
# End SECTION: local overrides

# === SECTION: mise activation (managed) ===
# Source: native read-only environment output, never prompt hooks or auto-install.
if [[ -n "${VIRTUAL_ENV:-}" && "${VIRTUAL_ENV}" != "${VENV_DIR}" ]]; then
  PATH_rm "${VIRTUAL_ENV}/bin" "${VIRTUAL_ENV}/Scripts"
fi
unset MYPYPATH {{ native_environment_unset | join(" ") }}
export MISE_CEILING_PATHS="${runtime_parent}"
export MISE_CONFIG_DIR="${RUNTIME_ROOT}/.mise"
export MISE_GLOBAL_CONFIG_FILE="${MISE_CONFIG_DIR}/config.toml"
export MISE_SYSTEM_CONFIG_DIR="${MISE_CONFIG_DIR}"
export MISE_AUTO_INSTALL=0
unset MISE_SYSTEM_CONFIG_FILE MISE_ENV MISE_ENV_FILE
mise_active="$(MISE_LOCKED=1 "${bootstrap_mise}" -C "${RUNTIME_ROOT}" tool "{{ toolchain.mise_selector }}" --active)" || return $?
mise_binary="$(MISE_LOCKED=1 "${bootstrap_mise}" -C "${RUNTIME_ROOT}" which mise)" || return $?
if [[ "${OS:-}" == Windows_NT ]]; then
  mise_binary="$(cygpath --unix "${mise_binary}")" || return $?
fi
PATH_rm "${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/mise}/shims" "${BOOTSTRAP_ROOT}/.bin/shims"
mise_environment="$("${mise_binary}" -C "${RUNTIME_ROOT}" env --shell bash)" || return $?
eval "${mise_environment}"
unset mise_environment mise_binary mise_active
# End SECTION: mise activation

# === SECTION: configured paths (managed) ===
# Source: config:environment_path_prepends
{%- for extra_path in environment_path_prepends %}
if [[ -d "${PROJECT_ROOT}/{{ extra_path }}" ]]; then
  PATH_add "${PROJECT_ROOT}/{{ extra_path }}"
fi
{% endfor %}
# End SECTION: configured paths

# === SECTION: virtual environment (managed) ===
# Source: native workspace ownership and the already provisioned environment.
export UV_PROJECT="${RUNTIME_ROOT}"
export UV_PROJECT_ENVIRONMENT="${VENV_DIR}"
export VIRTUAL_ENV="${VENV_DIR}"
PATH_add "${environment_bin}"
# End SECTION: virtual environment
