{% from "_fragments/release_bootstrap_steps.j2" import release_bootstrap_steps with context -%}
# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
#
# Release protocol projection. The workflow selects which protocol phase to
# run; every decision (next version, guard, tag identity, receipt, upload set)
# is made by the direct `make release-*` and `make publication` verbs, never here.
#
# - A push to the integration branch whose head is NOT the protocol's release
#   commit opens or updates the release pull request (`make release-version
#   `); when nothing is releasable the run is a no-op.
# - Release commits are validated but never publish unattended.
# - `workflow_dispatch` validates an existing tag, then builds one receipt and
#   publishes exactly what that receipt attests.
{% set persist_private_checkout_credentials = true -%}
name: Release

"on":
  push:
    branches:
      - {{ repository_branch }}
  workflow_dispatch:
    inputs:
      tag:
        description: "Existing release tag to build and publish again (example: v0.12.0)"
        required: true
        type: string

concurrency:
  group: release-{% raw %}${{ github.ref_name }}{% endraw %}
  cancel-in-progress: false

permissions: {}

jobs:
  identity:
    name: Resolve release state
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    outputs:
      release_commit: {% raw %}${{ steps.head.outputs.release_commit }}{% endraw %}
      ref: {% raw %}${{ steps.head.outputs.ref }}{% endraw %}
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          fetch-depth: 1
          persist-credentials: false
          ref: {% raw %}${{ github.event_name == 'workflow_dispatch' && format('refs/tags/{0}', inputs.tag) || github.sha }}{% endraw %}
      - name: Classify HEAD
        id: head
        env:
          EVENT_NAME: {% raw %}${{ github.event_name }}{% endraw %}
        shell: bash
        run: |
          set -euo pipefail
          subject="$(git log -1 --format=%s)"
          echo "ref=$(git rev-parse HEAD^{commit})" >> "${GITHUB_OUTPUT}"
          if [ "${EVENT_NAME}" = "workflow_dispatch" ]; then
            echo "release_commit=true" >> "${GITHUB_OUTPUT}"
          else
            case "${subject}" in
              "chore(release): v"*) echo "release_commit=true" >> "${GITHUB_OUTPUT}" ;;
              *) echo "release_commit=false" >> "${GITHUB_OUTPUT}" ;;
            esac
          fi

  candidate-ci:
    name: Validate exact release candidate
    needs: identity
    permissions:
      contents: read
{% if packages_read %}
      packages: read
{% endif %}
    uses: ./.github/workflows/ci.yml
    with:
      ref: {% raw %}${{ needs.identity.outputs.ref }}{% endraw %}
    secrets: inherit

  version:
    name: Open or update the release pull request
    needs: [identity, candidate-ci]
    if: needs.identity.outputs.release_commit == 'false'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    outputs:
      ref: {% raw %}${{ steps.version.outputs.ref }}{% endraw %}
    permissions:
      contents: write  # Push the release/next lane.
      pull-requests: write  # Open or update the release pull request.
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
      # GitHub standard: the built-in GITHUB_TOKEN with the declared job
      # permissions (contents: write, pull-requests: write) opens and updates
      # the release pull request. version-ci validates its resulting HEAD
      # directly: this token does not trigger pull-request or push workflows.
      GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          fetch-depth: 0
          ref: {% raw %}${{ needs.identity.outputs.ref }}{% endraw %}
          submodules: {{ checkout_submodules }}
          token: {% raw %}${{ github.token }}{% endraw %}
{%- include "_fragments/private_submodules_init.j2" %}
{%- include "_fragments/private_dependency_auth.j2" %}
{{- release_bootstrap_steps() }}
      - name: Admit validated integration commit
        env:
          INTEGRATION_BRANCH: {{ repository_branch }}
        run: git switch -C "${INTEGRATION_BRANCH}" HEAD
      - name: Release pull request
        id: version
        run: |
          set -euo pipefail
          make release-version
          echo "ref=$(git rev-parse HEAD^{commit})" >> "${GITHUB_OUTPUT}"

  version-ci:
    name: Validate release pull request commit
    needs: version
    permissions:
      contents: read
{% if packages_read %}
      packages: read
{% endif %}
    uses: ./.github/workflows/ci.yml
    with:
      ref: {% raw %}${{ needs.version.outputs.ref }}{% endraw %}
    secrets: inherit

  publish:
    name: Tag, build and publish the release commit
    needs: [identity, candidate-ci]
    if: github.event_name == 'workflow_dispatch' && needs.identity.outputs.release_commit == 'true' && needs.candidate-ci.result == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 180
    permissions:
      contents: write # Push the release tag and create the GitHub release.
{% if publish_index %}
      id-token: write # Trusted publishing to the package index.
{% endif %}
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
      GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
    steps:
      - name: Checkout release commit
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          fetch-depth: 0
          ref: {% raw %}${{ needs.identity.outputs.ref }}{% endraw %}
          submodules: {{ checkout_submodules }}
{%- include "_fragments/private_submodules_init.j2" %}
{%- include "_fragments/private_dependency_auth.j2" %}
{{- release_bootstrap_steps() }}
      - name: Tag
        run: make release-tag
      - name: Build receipt
        run: make release-build
      - name: Publish
        run: make publication{% if publish_index %} INDEX=Y{% endif %}
