# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
name: Release

"on":
  pull_request:
    branches: [{{ github_actions_promotion.target }}]
    types: {{ github_actions_workflows.delivery_event_types | list | tojson }}

permissions:
  contents: write

concurrency:
  group: release-promotion
  cancel-in-progress: false

jobs:
  release:
    name: Release merged governed promotion
    if: >-
      github.event.pull_request.merged == true &&
      github.base_ref == '{{ github_actions_promotion.target }}' &&
      contains(fromJSON('{{ github_actions_promotion.sources | list | tojson }}'), github.head_ref)
    runs-on: ubuntu-latest
    timeout-minutes: 180
    steps:
      - name: Checkout merged promotion
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          ref: {% raw %}${{ github.event.pull_request.merge_commit_sha }}{% endraw %}
          submodules: {{ checkout_submodules }}
          fetch-depth: 0
          persist-credentials: false

      - name: Setup Python
        uses: {{ github_actions["setup-python"].repository }}@{{ github_actions["setup-python"].sha }}  # {{ github_actions["setup-python"].version }}
        with:
          python-version-file: .python-version

      - name: Setup Go build dependency
        uses: {{ github_actions["setup-go"].repository }}@{{ github_actions["setup-go"].sha }}  # {{ github_actions["setup-go"].version }}
        with:
          go-version: "{{ go_version }}"
          cache: false

      - name: Install declared toolchain
        uses: {{ github_actions["mise"].repository }}@{{ github_actions["mise"].sha }}  # {{ github_actions["mise"].version }}
        with:
          version: "{{ mise_version }}"

      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          enable-cache: false

{% for step in make.workflow if "ci" in step.contexts %}
      - name: {{ step.verb | title }}
        run: make {{ step.verb }}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %} {{ make.ci.variable }}={{ make.ci.value }}
{% endfor %}

      - name: Release from version and repository SSOT
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: make {{ github_actions_workflows.release_verb }} {{ make.ci.variable }}={{ make.ci.value }}
