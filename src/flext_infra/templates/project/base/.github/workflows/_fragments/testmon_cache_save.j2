
{%- if make.testmon_cache_policy.save_enabled %}
      # Completed failing tests may save; cancelled/incomplete/corrupt runs cannot.
      - name: Save testmon database
        if: >-
          {% raw %}${{ always() && !cancelled() && steps.testmon_path.outputs.save_allowed == 'true' && steps.{% endraw %}{{ ci_tests.test_step_id }}{% raw %}.outputs.testmon_saveable == 'true' && steps.{% endraw %}{{ ci_tests.test_step_id }}{% raw %}.outputs.testmon_database == steps.testmon_path.outputs.database && steps.{% endraw %}{{ ci_tests.test_step_id }}{% raw %}.outputs.testmon_digest != '' }}{% endraw %}
        uses: {{ github_actions["cache"].repository }}/save@{{ github_actions["cache"].version }}
        with:
          path: {% raw %}${{ steps.{% endraw %}{{ ci_tests.test_step_id }}{% raw %}.outputs.testmon_database }}{% endraw %}
          key: {% raw %}${{ steps.testmon_path.outputs.key }}{% endraw %}
{%- endif %}
