
      # Why: a failed gate's job log prints only counts; its raw receipts under
      # the declared gate receipts directory are the evidence. Only approval
      # rows capture receipts, so the upload runs exactly when one of them
      # failed (tests included), never after a setup failure that left none.
      - name: Upload gate receipts on failure
        if: {% raw %}${{ failure() && ({% endraw %}{{ gate_receipts_failed }}{% raw %}) }}{% endraw %}
        uses: {{ github_actions["upload-artifact"].repository }}@{{ github_actions["upload-artifact"].version }}
        with:
          name: flext-gate-receipts-{% raw %}${{ github.job }}-${{ github.run_id }}{% endraw %}
          path: {{ report_root }}{{ make.gate_receipts_directory }}/**
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 7