{%- if private_submodules %}
          persist-credentials: false

      - name: Init private workspace members
        env:
{% for key in private_submodules.deploy_keys %}
          {{ key.secret }}: {% raw %}${{ secrets.{% endraw %}{{ key.secret }}{% raw %} }}{% endraw %}
{% endfor %}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          ssh-keyscan -T 10 github.com >> ~/.ssh/known_hosts 2>/dev/null
{% for key in private_submodules.deploy_keys %}
          if [ -z "${{ '{' }}{{ key.secret }}{{ '}' }}" ]; then
            echo "::error::secret {{ key.secret }} missing — private submodule {{ key.path }} requires a read-only deploy key"
            exit 1
          fi
          printf '%s\n' "${{ '{' }}{{ key.secret }}{{ '}' }}" > "$HOME/.ssh/{{ key.secret | lower }}"
          chmod 600 "$HOME/.ssh/{{ key.secret | lower }}"
{% endfor %}
          {
{% for key in private_submodules.deploy_keys %}
            printf 'Host {{ key.host_alias }}\n  HostName github.com\n  User git\n  IdentityFile ~/.ssh/{{ key.secret | lower }}\n  IdentitiesOnly yes\n  StrictHostKeyChecking yes\n'
{% endfor %}
          } >> ~/.ssh/config
          chmod 600 ~/.ssh/config
          git submodule sync -- {% for p in private_submodules.paths %}{{ p }} {% endfor %}
{% for key in private_submodules.deploy_keys %}
          git config submodule.{{ key.submodule }}.url {{ key.ssh_url }}
{% endfor %}
          git submodule update --init --depth 1 --jobs 2 -- {% for p in private_submodules.paths %}{{ p }} {% endfor %}
{% for key in private_submodules.deploy_keys %}
          git -C {{ key.path }} remote set-url origin {{ key.ssh_url }}
{% endfor %}
{%- endif -%}
