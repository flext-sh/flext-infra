{% from "_fragments/superproject_checkout.j2" import superproject_checkout with context %}
{% macro matrix_host_steps(explicit_bash) %}
{%- if superproject %}
    defaults:
      run:
        working-directory: {{ superproject.path }}
{%- endif %}
    steps:
{%- if superproject %}
{{- superproject_checkout("github.sha") }}
{%- else %}
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          submodules: {{ "false" if private_submodules or private_dependency_auth else checkout_submodules }}
{% if not private_submodules %}
          # Dependency authentication uses the declared process configuration,
          # never a persisted checkout credential.
          persist-credentials: false
{% endif %}
{%- endif %}
{%- include "_fragments/private_submodules_init.j2" %}
{%- include "_fragments/private_dependency_auth.j2" %}
      # The ordered public acceptance steps (make.lifecycle_steps, ci
      # context): the matrix never keeps its own verb list.
      - name: Lifecycle acceptance
{% if explicit_bash %}        shell: bash
{% endif %}        run: |
{%- for step in make.lifecycle_steps if "ci" in step.contexts %}
          {{ make.ci.variable }}={{ make.ci.value }} {{ step.make_command }}
{%- endfor %}
{%- endmacro %}
