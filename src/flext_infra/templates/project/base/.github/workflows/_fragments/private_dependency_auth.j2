{%- if private_dependency_auth %}

      # The declared App authenticates only its selected private repositories.
      # Native Git process configuration reaches dependency clones without
      # credential files, global URL rewrites, or changes to SDK token aliases.
      - name: Mint the private-dependency installation token
        id: private_dependency_token
        # Push and workflow_dispatch both build the dependency tree; the
        # dispatch form is how the fleet re-runs a consumer's CI after
        # advancing a private member pin (merge-admin 2026-10-07, cosmos-main
        # evidence: the mint skipped on dispatch and the private dep clone
        # failed without credential).
        if: {% raw %}${{ github.event_name == 'push' || github.event_name == 'workflow_dispatch' }}{% endraw %}
        uses: {{ github_actions["create-github-app-token"].repository }}@{{ github_actions["create-github-app-token"].version }}
        with:
          client-id: {% raw %}${{ secrets.{% endraw %}{{ private_dependency_auth.app_id_secret }}{% raw %} }}{% endraw %}
          private-key: {% raw %}${{ secrets.{% endraw %}{{ private_dependency_auth.private_key_secret }}{% raw %} }}{% endraw %}
          owner: {% raw %}${{ github.repository_owner }}{% endraw %}
          repositories: {{ private_dependency_auth.repositories | join(",") }}
          permission-contents: read

      - name: Authenticate git for private dependencies
        if: {% raw %}${{ steps.private_dependency_token.outputs.token != '' }}{% endraw %}
        shell: bash
        env:
          PRIVATE_DEPENDENCY_TOKEN: {% raw %}${{ steps.private_dependency_token.outputs.token }}{% endraw %}
        run: |
          set -euo pipefail
          : "${GITHUB_ENV:?GITHUB_ENV is required for private dependency identity}"
          : "${GITHUB_REPOSITORY_OWNER:?GITHUB_REPOSITORY_OWNER is required}"
          if [ -z "${PRIVATE_DEPENDENCY_TOKEN}" ]; then
            echo "::error::the {{ private_dependency_auth.app_id_secret }} App produced no installation token - a private git dependency cannot be resolved"
            exit 1
          fi
          count="${GIT_CONFIG_COUNT:-0}"
          if [[ ! "${count}" =~ ^(0|[1-9][0-9]{0,9})$ ]]; then
            echo "::error::GIT_CONFIG_COUNT must be a non-negative decimal integer"
            exit 1
          fi
          if (( count > 2147483647 - {{ private_dependency_auth.repositories | length * 2 }} )); then
            echo "::error::private dependency configuration exceeds Git's entry limit"
            exit 1
          fi
          # Let Git validate inherited entries without displaying their values.
          git config --list --name-only > /dev/null
          repositories=(
{% for repository in private_dependency_auth.repositories %}
            '{{ repository | replace("'", "'\"'\"'") }}'
{% endfor %}
          )
          for repository in "${repositories[@]}"; do
            if [[ ! "${repository}" =~ ^[A-Za-z0-9_.-]+$ || "${repository}" == . || "${repository}" == .. ]]; then
              echo "::error::private dependency repositories must be repository names"
              exit 1
            fi
          done
          authorization="$(printf 'x-access-token:%s' "${PRIVATE_DEPENDENCY_TOKEN}" | base64 | tr -d '\n')"
          printf '::add-mask::%s\n' "${authorization}"
          for repository in "${repositories[@]}"; do
            # Both canonical HTTPS spellings use the same minted identity.
            for suffix in '' '.git'; do
              printf 'GIT_CONFIG_KEY_%s=http.https://github.com/%s/%s%s.extraheader\n' \
                "${count}" "${GITHUB_REPOSITORY_OWNER}" "${repository}" "${suffix}" >> "${GITHUB_ENV}"
              printf 'GIT_CONFIG_VALUE_%s=AUTHORIZATION: basic %s\n' \
                "${count}" "${authorization}" >> "${GITHUB_ENV}"
              count=$((count + 1))
            done
          done
          printf 'GIT_CONFIG_COUNT=%s\n' "${count}" >> "${GITHUB_ENV}"
{%- endif -%}
