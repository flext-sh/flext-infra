
      - name: Save tool caches
        # Native cache action access mode remains authoritative before upload.
        # Only branch pushes and explicit dispatch publish. A pull request
        # restores only: its entry is scoped to refs/pull/N/merge, visible to no
        # other ref, so saving it stored one ~700 MB copy of the same lock state
        # per PR until the repository quota evicted the integration branch's
        # entry. An exact hit already holds this lock state: save only on a miss.
        if: >-
          {% raw %}${{ always() && !cancelled() && steps.tool-cache.outcome == 'success' && steps.tool-cache.outputs.cache-hit != 'true' && steps.tool-cache.outputs.cache-primary-key != '' && ((github.event_name == 'push' && startsWith(github.ref, 'refs/heads/')) || github.event_name == 'workflow_dispatch') }}{% endraw %}
        uses: {{ github_actions["cache"].repository }}/save@{{ github_actions["cache"].version }}
        with:
          path: |
{% include "_fragments/toolchain_cache_paths.j2" %}
          key: {% raw %}${{ steps.tool-cache.outputs.cache-primary-key }}{% endraw %}
