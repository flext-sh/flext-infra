
      # Why: make test always selects through the persistent testmon database
      # (make.testmon_cache), which lives outside the checkout under the
      # declared project name. A runner without it starts from an empty history
      # and selects the whole suite. Restore the newest database of any earlier
      # run: testmon revalidates every recorded file by checksum, so a restored
      # database never hides a changed dependency of a selected test.
      - name: Resolve project testmon database
        id: testmon_path
        env:
          CACHE_BRANCH: {% raw %}${{ github.head_ref || github.ref_name }}{% endraw %}
          CACHE_SEED_BRANCH: {% raw %}${{ github.base_ref || github.event.repository.default_branch }}{% endraw %}
          CACHE_WRITE_ALLOWED: {% raw %}${{ (github.event_name == 'push' && startsWith(github.ref, 'refs/heads/')) || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) }}{% endraw %}
          CACHE_INPUTS: {% raw %}${{ hashFiles('uv.lock', 'mise.lock', 'pyproject.toml', 'config/**') }}{% endraw %}
          CACHE_PLATFORM: {% raw %}${{ runner.os }}-${{ runner.arch }}{% endraw %}
          CACHE_GENERATION: {% raw %}${{ github.run_id }}-${{ github.run_attempt }}{% endraw %}
        run: |
          set -eu
          cache_home="{{ '${' }}{{ make.testmon_cache.data_home_environment_variable }}{{ ':-' }}{{ '${' }}{{ make.testmon_cache.user_home_environment_variable }}{{ '}' }}/{{ make.testmon_cache.home_cache_directory }}}"
          database="$(realpath -m "$cache_home/{{ make.testmon_cache.external_storage_directory }}/{{ dist }}/{{ make.testmon_cache.database_filename }}")"
          case "$database" in /*) ;; *) exit 2 ;; esac
          printf 'database=%s\n' "$database" >> "$GITHUB_OUTPUT"
          branch_digest="$(printf '%s' "$CACHE_BRANCH" | sha256sum)"
          seed_digest="$(printf '%s' "$CACHE_SEED_BRANCH" | sha256sum)"
          namespace="$CACHE_PLATFORM-{{ python_version }}-{{ make.testmon_cache_policy.key_prefix }}-{{ dist }}-${branch_digest%% *}-"
          seed_namespace="$CACHE_PLATFORM-{{ python_version }}-{{ make.testmon_cache_policy.key_prefix }}-{{ dist }}-${seed_digest%% *}-"
          printf 'namespace=%s\nseed_namespace=%s\nsave_allowed=%s\n' "$namespace" "$seed_namespace" "$CACHE_WRITE_ALLOWED" >> "$GITHUB_OUTPUT"
          printf 'key=%s%s-%s\n' "$namespace" "$CACHE_INPUTS" "$CACHE_GENERATION" >> "$GITHUB_OUTPUT"
      - name: Restore testmon database
        uses: {{ github_actions["cache"].repository }}/restore@{{ github_actions["cache"].version }}
        with:
          path: {% raw %}${{ steps.testmon_path.outputs.database }}{% endraw %}
          key: {% raw %}${{ steps.testmon_path.outputs.key }}{% endraw %}
          restore-keys: |
            {% raw %}${{ steps.testmon_path.outputs.namespace }}${{ hashFiles('uv.lock', 'mise.lock', 'pyproject.toml', 'config/**') }}-{% endraw %}
            {% raw %}${{ steps.testmon_path.outputs.namespace }}{% endraw %}
            {% raw %}${{ steps.testmon_path.outputs.seed_namespace }}{% endraw %}
