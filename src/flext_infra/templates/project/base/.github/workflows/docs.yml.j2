# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
name: Docs

"on":
  push:
    branches:
      - main
      - {{ repository_branch }}
    paths:
      - "docs/**"
      - "mkdocs.yml"
      - "pyproject.toml"
{% for repository in workspace_repositories %}
      - "{{ repository.path }}/**"
{% endfor %}
      - ".github/workflows/docs.yml"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  docs-quality:
    name: docs-quality
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          fetch-depth: 0
{% include "base/.github/workflows/_fragments/private_submodules_init.j2" %}

      - name: Setup Python
        uses: {{ github_actions["setup-python"].repository }}@{{ github_actions["setup-python"].sha }}  # {{ github_actions["setup-python"].version }}
        with:
          python-version: "{{ python_version }}"

      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          enable-cache: true

      - name: Sync workspace toolchain
        run: make setup

      # mro-o6h5 (agent: kimi) — failure diagnostics: per-project logs live under
      # .reports/workspace/docs/*.log and were invisible in CI ("0 errors" FAILs);
      # dump them inline + per-project audit-report.md for non-zero issue counts +
      # upload as artifact so the real error is always reachable.
      - name: Docs audit (blocking)
        run: |
          make docs DOCS_PHASE=audit || {
            for f in .reports/workspace/docs/*.log; do
              echo "=== $f ==="
              tail -60 "$f"
            done
            for r in */.reports/docs/audit-summary.json; do
              [ -f "$r" ] || continue
              n=$(grep -o '"issues": [0-9]*' "$r" | head -1 | grep -o '[0-9]*')
              if [ "${n:-0}" -gt 0 ]; then
                echo "=== $(dirname "$r")/audit-report.md ==="
                cat "$(dirname "$r")/audit-report.md"
              fi
            done
            exit 1
          }

      - name: Docs generate (materialize contract artifacts)
        run: make docs WHAT=generate APPLY=Y

      - name: Docs validate (blocking)
        run: |
          make docs DOCS_PHASE=validate || {
            for f in .reports/workspace/docs/*.log; do
              echo "=== $f ==="
              tail -60 "$f"
            done
            exit 1
          }

      # mro-o6h5 (agent: kimi) — include-hidden-files: .reports/ is a dot-dir and
      # upload-artifact v4 skips hidden paths by default (artifact silently empty).
      - name: Upload docs reports on failure
        if: failure()
        uses: {{ github_actions["upload-artifact"].repository }}@{{ github_actions["upload-artifact"].sha }}  # {{ github_actions["upload-artifact"].version }}
        with:
          name: docs-reports
          path: .reports/
          retention-days: 7
          include-hidden-files: true

  build:
    name: build
    needs: docs-quality
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          fetch-depth: 0
{% include "base/.github/workflows/_fragments/private_submodules_init.j2" %}

      - name: Setup Python
        uses: {{ github_actions["setup-python"].repository }}@{{ github_actions["setup-python"].sha }}  # {{ github_actions["setup-python"].version }}
        with:
          python-version: "{{ python_version }}"

      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          enable-cache: true

      - name: Sync workspace toolchain
        run: make setup

      - name: Generate docs
        run: make docs WHAT=generate APPLY=Y

      - name: Build site
        run: make docs WHAT=build

      - name: Configure Pages
        uses: {{ github_actions["configure-pages"].repository }}@{{ github_actions["configure-pages"].sha }}  # {{ github_actions["configure-pages"].version }}

      - name: Upload site artifact
        uses: {{ github_actions["upload-pages-artifact"].repository }}@{{ github_actions["upload-pages-artifact"].sha }}  # {{ github_actions["upload-pages-artifact"].version }}
        with:
          path: .reports/docs/site

  deploy:
    name: deploy
    needs: build
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: github-pages
      url: {% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: {{ github_actions["deploy-pages"].repository }}@{{ github_actions["deploy-pages"].sha }}  # {{ github_actions["deploy-pages"].version }}
