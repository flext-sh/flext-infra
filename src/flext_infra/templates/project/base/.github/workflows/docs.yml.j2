# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
name: Docs

"on":
  pull_request:
    branches: [{{ github_actions_promotion.target }}]
    types: {{ github_actions_workflows.delivery_event_types | list | tojson }}

permissions:
  contents: read
  id-token: write
  pages: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  docs:
    name: Build and publish docs after governed promotion
    if: >-
      github.event.pull_request.merged == true &&
      github.base_ref == '{{ github_actions_promotion.target }}' &&
      contains(fromJSON('{{ github_actions_promotion.sources | list | tojson }}'), github.head_ref)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment:
      name: github-pages
      url: {% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}
    steps:
      - name: Checkout merged promotion
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          ref: {% raw %}${{ github.event.pull_request.merge_commit_sha }}{% endraw %}
          submodules: {{ checkout_submodules }}
          fetch-depth: 0

      - name: Setup Python
        uses: {{ github_actions["setup-python"].repository }}@{{ github_actions["setup-python"].sha }}  # {{ github_actions["setup-python"].version }}
        with:
          python-version-file: .python-version

      - name: Install declared toolchain
        uses: {{ github_actions["mise"].repository }}@{{ github_actions["mise"].sha }}  # {{ github_actions["mise"].version }}
        with:
          version: "{{ mise_version }}"

      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          enable-cache: true

{% for lifecycle_step in github_actions_workflows.lifecycle %}
      - name: {{ lifecycle_step.verb | title }}
        run: make {{ lifecycle_step.verb }}{% if lifecycle_step.apply %} APPLY=Y{% endif %} CI=Y
{% endfor %}

      - name: Build docs
        run: make {{ github_actions_workflows.docs_verb }} CI=Y

      - name: Configure Pages
        uses: {{ github_actions["configure-pages"].repository }}@{{ github_actions["configure-pages"].sha }}  # {{ github_actions["configure-pages"].version }}

      - name: Upload Pages artifact
        uses: {{ github_actions["upload-pages-artifact"].repository }}@{{ github_actions["upload-pages-artifact"].sha }}  # {{ github_actions["upload-pages-artifact"].version }}
        with:
          path: {{ github_actions_workflows.docs_artifact_path }}

      - name: Deploy Pages
        id: deployment
        uses: {{ github_actions["deploy-pages"].repository }}@{{ github_actions["deploy-pages"].sha }}  # {{ github_actions["deploy-pages"].version }}
