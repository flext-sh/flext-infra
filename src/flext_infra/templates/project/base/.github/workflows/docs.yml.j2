{% from "_fragments/docs_job_checkout.j2" import docs_job_checkout with context -%}
{%- set report_root = (superproject.path ~ "/") if superproject else "" -%}
# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
name: Docs

"on":
  push:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
    paths:
      - "docs/**"
      - "mkdocs.yml"
      - "pyproject.toml"
{% for repository in workspace_repositories %}
      - "{{ repository.path }}/**"
{% endfor %}
      - ".github/workflows/docs.yml"
  workflow_dispatch:

permissions: {}

jobs:
  docs-quality:
    name: docs-quality
    runs-on: ubuntu-latest
    timeout-minutes: 60
    # Why: a newer push to the same branch makes this proof obsolete, so it is
    # cancelled. The group holds only this job: a deploy that already started
    # sits in its own non-cancelling group and always finishes.
    concurrency:
      group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
      cancel-in-progress: true
    # packages: read only for distributions declared in codegen
    # ci_package_registry_read: make gen/check resolve their GitHub Packages.
    permissions:
      contents: read
{%- if packages_read %}
      packages: read
{%- endif %}
    # Why: GitHub-hosted runners share egress IPs, so the unauthenticated
    # 60 req/h REST budget is exhausted before mise resolves the moving
    # @latest backends (observed 2026-09-23: 403, rate limit 0/60, on every
    # backend in Sync workspace toolchain), and docs generation reads the
    # governed sibling repos. The job token authenticates both, as in CI.
{{- docs_job_checkout() }}

      # Why: a cold runner re-downloaded every locked Mise tool
      # (go included) on every Docs run, and a network blip failed setup. The
      # cache is content-addressed by the committed locks, so a warm cache is
      # always valid for the same lock and can never hide a finding; it only
      # removes the cold download of the pinned tarballs.
{%- include "_fragments/toolchain_cache_restore.j2" %}

      - name: Sync workspace toolchain
        run: make setup

      # Why: save on every outcome — including a failing gate — so the next run
      # starts warm. Only written when the restore missed.
{%- include "_fragments/toolchain_cache_save.j2" %}
{%- include "_fragments/custom_steps.j2" %}

      - name: Generate documentation
        run: make gen

      - name: Build site
        run: make build

      # One check per run, on the tree the site was built from.
      - name: Check documentation and projections
        run: make check

{%- if docs_site_publish %}

      # The site artifact exists only to feed deploy on main; an integration
      # push proves the build and uploads nothing.
      - name: Upload site artifact
        if: github.ref == 'refs/heads/main'
        uses: {{ github_actions["upload-pages-artifact"].repository }}@{{ github_actions["upload-pages-artifact"].version }}
        with:
          path: {{ report_root }}.reports/docs/site
{%- endif %}

      # Failure diagnostics execute only after the original Make step has
      # already propagated its exact status to Actions.
      - name: Dump docs reports on failure
        if: failure()
        run: |
          set -eu
          for report_root in .reports apps; do
            if [ -d "${report_root}" ]; then
              find "${report_root}" \
                \( {% for name in docs_report_filenames %}{% if not loop.first %}-o {% endif %}-path '*/{{ name }}' {% endfor %}\) \
                -type f -exec sh -eu -c '
                  for report_file do
                    printf "::group::%s\n" "${report_file}"
                    cat "${report_file}"
                    printf "::endgroup::\n"
                  done
                ' sh {} +
            fi
          done

      - name: Upload docs reports on failure
        if: failure()
        uses: {{ github_actions["upload-artifact"].repository }}@{{ github_actions["upload-artifact"].version }}
        with:
          name: docs-reports
          # Structured docs reports only — omit raw docs log trees that may carry
          # env-derived secrets from lifecycle commands.
          path: |{% for prefix in (".reports/**", "apps/*/.reports/**") %}{% for name in docs_report_filenames %}
            {{ report_root }}{{ prefix }}/{{ name }}{% endfor %}{% endfor %}
          if-no-files-found: error
          # The allowlisted reports live under hidden .reports directories.
          # upload-artifact excludes hidden paths unless this is explicit.
          include-hidden-files: true
          retention-days: 7
{%- if docs_site_publish %}

  deploy:
    name: deploy
    needs: docs-quality
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    # A running publication to Pages is never cancelled; a newer one waits.
    concurrency:
      group: pages
      cancel-in-progress: false
    permissions:
      # Configure Pages reads the Pages REST endpoint, which rejects a token
      # without Pages write ("Resource not accessible by integration"); only
      # this job, which runs no project code, holds it.
      pages: write
      id-token: write
    steps:
      - name: Configure Pages
        uses: {{ github_actions["configure-pages"].repository }}@{{ github_actions["configure-pages"].version }}

      - name: Deploy to GitHub Pages
        id: deployment
        uses: {{ github_actions["deploy-pages"].repository }}@{{ github_actions["deploy-pages"].version }}
{%- endif %}
