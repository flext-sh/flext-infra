# Generated by `flext_infra codegen conform` for {{ dist }}.
# === SECTION: header (managed) ===
# Source: template (base/.github/workflows/ci-matrix.yml.j2)
# Free: no
# End SECTION: header
# Multi-environment CI base: proves the project bootstrap and canonical Make
# verbs work identically across distros, macOS, and Windows. The CI invokes
# the project's own Make surface; it never reimplements bootstrap.
---
name: ci-matrix

# === SECTION: triggers (managed) ===
# Source: config:github_actions_promotion
"on":
  pull_request:
    branches: [{{ github_actions_promotion.target }}]
    types: [opened, synchronize, reopened, ready_for_review]
# End SECTION: triggers

# === SECTION: permissions (managed) ===
# Source: template (minimal read-only permissions)
permissions:
  contents: read
# End SECTION: permissions

# === SECTION: concurrency (managed) ===
# Source: template (one run per workflow+ref)
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true
# End SECTION: concurrency

jobs:
  # === SECTION: distro-matrix (managed) ===
  # Source: template + config:github_actions.checkout (distro list is template literal by design)
  distro-matrix:
    if: >-
      github.base_ref == '{{ github_actions_promotion.target }}' &&
      contains(fromJSON('{{ github_actions_promotion.sources | list | tojson }}'), github.head_ref)
    # Clean-machine proof per distro: build the distro image (which runs the
    # full project bootstrap at image-build time), then smoke the verb surface
    # inside the built container.
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        distro: [ubuntu, debian, fedora, alpine, arch]
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
      - name: Build {% raw %}${{ matrix.distro }}{% endraw %} image
        run: >-
          docker build
          -f ci/docker/{% raw %}${{ matrix.distro }}{% endraw %}.Dockerfile
          -t ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %}
          .
      - name: Bootstrap + verb smoke ({% raw %}${{ matrix.distro }}{% endraw %})
        run: |
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} mise exec -- python --version
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} mise exec -- go version
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} mise exec -- rustc --version
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} mise exec -- ast-grep --version
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} mise exec -- bd version
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} make setup CI=Y
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} make gen APPLY=Y CI=Y
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} make fmt APPLY=Y CI=Y
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} make fix APPLY=Y CI=Y
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} make check CI=Y
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} make test CI=Y
      # End SECTION: distro-matrix

  # === SECTION: macos (managed) ===
  # Source: template + config:github_actions.checkout/setup-python/mise/setup-uv
  macos:
    if: >-
      github.base_ref == '{{ github_actions_promotion.target }}' &&
      contains(fromJSON('{{ github_actions_promotion.sources | list | tojson }}'), github.head_ref)
    runs-on: macos-latest
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
      - name: Setup Python
        uses: {{ github_actions["setup-python"].repository }}@{{ github_actions["setup-python"].sha }}  # {{ github_actions["setup-python"].version }}
        with:
          python-version-file: .python-version
      - name: Install mise toolchain
        uses: {{ github_actions["mise"].repository }}@{{ github_actions["mise"].sha }}  # {{ github_actions["mise"].version }}
        with:
          version: "{{ mise_version }}"
      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          enable-cache: true
      - name: Bootstrap
        run: make setup CI=Y
      - name: Generate
        run: make gen APPLY=Y CI=Y
      - name: Format
        run: make fmt APPLY=Y CI=Y
      - name: Fix
        run: make fix APPLY=Y CI=Y
      - name: Check
        run: make check CI=Y
      - name: Test
        run: make test CI=Y
      - name: Toolchain smoke
        run: |
          mise exec -- python --version
          mise exec -- go version
          mise exec -- rustc --version
          mise exec -- ast-grep --version
          mise exec -- bd version
  # End SECTION: macos

  # === SECTION: windows (managed) ===
  # Source: template + config:github_actions.checkout/setup-python/mise/setup-uv
  windows:
    if: >-
      github.base_ref == '{{ github_actions_promotion.target }}' &&
      contains(fromJSON('{{ github_actions_promotion.sources | list | tojson }}'), github.head_ref)
    runs-on: windows-latest
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
      - name: Setup Python
        uses: {{ github_actions["setup-python"].repository }}@{{ github_actions["setup-python"].sha }}  # {{ github_actions["setup-python"].version }}
        with:
          python-version-file: .python-version
      - name: Install mise toolchain
        uses: {{ github_actions["mise"].repository }}@{{ github_actions["mise"].sha }}  # {{ github_actions["mise"].version }}
        with:
          version: "{{ mise_version }}"
      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          enable-cache: true
      - name: Bootstrap
        shell: bash
        run: make setup CI=Y
      - name: Generate
        shell: bash
        run: make gen APPLY=Y CI=Y
      - name: Format
        shell: bash
        run: make fmt APPLY=Y CI=Y
      - name: Fix
        shell: bash
        run: make fix APPLY=Y CI=Y
      - name: Check
        shell: bash
        run: make check CI=Y
      - name: Test
        shell: bash
        run: make test CI=Y
      - name: Toolchain smoke
        shell: bash
        run: |
          mise exec -- python --version
          mise exec -- go version
          mise exec -- rustc --version
          mise exec -- ast-grep --version
          mise exec -- bd version
# End SECTION: windows
