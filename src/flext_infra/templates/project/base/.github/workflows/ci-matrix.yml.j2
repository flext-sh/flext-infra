# Generated by `flext_infra codegen conform` for {{ dist }}.
# === SECTION: header (managed) ===
# Source: template (base/.github/workflows/ci-matrix.yml.j2)
# Free: no
# End SECTION: header
# Multi-environment CI base: proves the project bootstrap and canonical Make
# verbs work identically across distros, macOS, and Windows. The CI invokes
# the project's own Make surface; it never reimplements bootstrap.
---
name: ci-matrix

# === SECTION: triggers (managed) ===
# Source: config:github_actions_promotion
"on":
  pull_request:
    branches: [{{ github_actions_promotion.target }}]
    types: {{ github_actions_workflows.validation_event_types | list | tojson }}
# End SECTION: triggers

# === SECTION: permissions (managed) ===
# Source: template (minimal read-only permissions)
permissions:
  contents: read
# End SECTION: permissions

# === SECTION: concurrency (managed) ===
# Source: template (one run per workflow+ref)
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true
# End SECTION: concurrency

jobs:
  # === SECTION: distro-matrix (managed) ===
  # Source: template + config:github_actions.checkout (distro list is template literal by design)
  distro-matrix:
    if: >-
      github.base_ref == '{{ github_actions_promotion.target }}' &&
      contains(fromJSON('{{ github_actions_promotion.sources | list | tojson }}'), github.head_ref)
    # Clean-machine proof per distro: build the distro image, then run the
    # complete lifecycle once in one persistent container.
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        distro: [ubuntu, debian, fedora, alpine, arch]
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
      - name: Build {% raw %}${{ matrix.distro }}{% endraw %} image
        run: >-
          docker build
          -f ci/docker/{% raw %}${{ matrix.distro }}{% endraw %}.Dockerfile
          -t ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %}
          .
      - name: Canonical lifecycle ({% raw %}${{ matrix.distro }}{% endraw %})
        run: |
          docker run --rm ci-matrix-{% raw %}${{ matrix.distro }}{% endraw %} /bin/bash -lc '
{% for step in make.workflow if "ci" in step.contexts %}
            make {{ step.verb }}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %} {{ make.ci.variable }}={{ make.ci.value }}{% if not loop.last %} &&{% endif %}
{% endfor %}
          '
      # End SECTION: distro-matrix

  # === SECTION: macos (managed) ===
  # Source: template + config:github_actions.checkout/setup-python/setup-go/mise/setup-uv
  macos:
    if: >-
      github.base_ref == '{{ github_actions_promotion.target }}' &&
      contains(fromJSON('{{ github_actions_promotion.sources | list | tojson }}'), github.head_ref)
    runs-on: macos-latest
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
      - name: Setup Python
        uses: {{ github_actions["setup-python"].repository }}@{{ github_actions["setup-python"].sha }}  # {{ github_actions["setup-python"].version }}
        with:
          python-version-file: .python-version
      - name: Setup Go build dependency
        uses: {{ github_actions["setup-go"].repository }}@{{ github_actions["setup-go"].sha }}  # {{ github_actions["setup-go"].version }}
        with:
          go-version: "{{ go_version }}"
          cache: false
      - name: Install mise toolchain
        uses: {{ github_actions["mise"].repository }}@{{ github_actions["mise"].sha }}  # {{ github_actions["mise"].version }}
        with:
          version: "{{ mise_version }}"
      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          enable-cache: true
{% for step in make.workflow if "ci" in step.contexts %}
      - name: {{ step.verb | title }}
        run: make {{ step.verb }}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %} {{ make.ci.variable }}={{ make.ci.value }}
{% endfor %}
  # End SECTION: macos

  # === SECTION: windows (managed) ===
  # Source: template + config:github_actions.checkout/setup-python/setup-go/mise/setup-uv
  windows:
    if: >-
      github.base_ref == '{{ github_actions_promotion.target }}' &&
      contains(fromJSON('{{ github_actions_promotion.sources | list | tojson }}'), github.head_ref)
    runs-on: windows-latest
    steps:
      - uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
      - name: Setup Python
        uses: {{ github_actions["setup-python"].repository }}@{{ github_actions["setup-python"].sha }}  # {{ github_actions["setup-python"].version }}
        with:
          python-version-file: .python-version
      - name: Setup Go build dependency
        uses: {{ github_actions["setup-go"].repository }}@{{ github_actions["setup-go"].sha }}  # {{ github_actions["setup-go"].version }}
        with:
          go-version: "{{ go_version }}"
          cache: false
      - name: Install mise toolchain
        uses: {{ github_actions["mise"].repository }}@{{ github_actions["mise"].sha }}  # {{ github_actions["mise"].version }}
        with:
          version: "{{ mise_version }}"
      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          enable-cache: true
{% for step in make.workflow if "ci" in step.contexts %}
      - name: {{ step.verb | title }}
        shell: bash
        run: make {{ step.verb }}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %} {{ make.ci.variable }}={{ make.ci.value }}
{% endfor %}
# End SECTION: windows
