name: Release plan

# === SECTION: triggers (managed) ===
# Source: release protocol — the read-only decision on every non-draft pull
# request. It owns `edited`: a title edit re-runs only this guard and never
# cancels CI, whose workflow does not listen to edits.
"on":
  pull_request:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
    types: [opened, synchronize, reopened, ready_for_review, edited]
# End SECTION: triggers

# Why: a newer title or head supersedes the pending decision of the same PR.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number }}{% endraw %}
  cancel-in-progress: true

jobs:
  # === SECTION: release-plan job (managed) ===
  # The title must be a Conventional Commits title (it becomes the merge
  # commit subject the next release is derived from), and no pyproject version
  # may change outside the protocol's own release commit.
  release-plan:
    name: release-plan
    permissions:
      contents: read
    if: {% raw %}${{ github.event.pull_request.draft == false }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
{%- if superproject %}
    defaults:
      run:
        working-directory: {{ superproject.path }}
{%- endif %}
    steps:
{%- if superproject %}
{{- superproject_checkout("github.sha") }}
{%- else %}
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          fetch-depth: 0
          submodules: {{ "false" if private_submodules or private_dependency_auth else checkout_submodules }}
{% if not private_submodules %}
          persist-credentials: false
{% endif %}
{%- endif %}
{%- include "_fragments/private_submodules_init.j2" %}
{%- include "_fragments/private_dependency_auth.j2" %}
{%- include "_fragments/toolchain_cache_restore.j2" %}
{%- include "_fragments/custom_steps.j2" %}
      - name: Boot
        run: {{ make.ci.variable }}={{ make.ci.value }} make setup
      - name: Release plan and guard
        env:
          PR_TITLE: {% raw %}${{ github.event.pull_request.title }}{% endraw %}
        run: {{ make.ci.variable }}={{ make.ci.value }} make release-plan
{%- include "_fragments/toolchain_cache_save.j2" %}
  # End SECTION: release-plan job
