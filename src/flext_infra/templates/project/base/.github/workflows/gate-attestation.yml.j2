# Generated by flext_infra codegen for {{ dist }} — DO NOT EDIT
name: Gate Attestation

"on":
  push:
    tags:
      - '{{ make.work_in_progress.attestation_tag_prefix }}/**'

jobs:
  gate-attestation:
    name: gate-attestation
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
      attestations: write
    steps:
      - name: Checkout attested commit
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          fetch-depth: 0
      - name: Install mise toolchain
        uses: {{ github_actions["mise"].repository }}@{{ github_actions["mise"].sha }}  # {{ github_actions["mise"].version }}
        with:
          version: {{ mise_version }}
      - name: Set up uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}
        with:
          version: {{ uv_version }}
          enable-cache: true
          cache-dependency-glob: uv.lock
      - name: Prepare verifier runtime
        run: make setup
      - name: Verify local signed receipt
        env:
          GATE_RECEIPT_OUTPUT: {% raw %}${{ runner.temp }}/gate-receipt.json{% endraw %}
        run: |
          GATE_COMMIT_SHA=$(git rev-list -n 1 "$GITHUB_REF_NAME")
          export GATE_COMMIT_SHA
          .github/scripts/gate-attestation.sh verify
      - name: Register GitHub artifact attestation
        uses: {{ github_actions["attest"].repository }}@{{ github_actions["attest"].sha }}  # {{ github_actions["attest"].version }}
        with:
          subject-path: {% raw %}${{ runner.temp }}/gate-receipt.json{% endraw %}
