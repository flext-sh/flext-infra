name: CI

# === SECTION: triggers (managed) ===
# Source: CI policy — integration push/PR = blocking CI only;
# main push/PR (non-draft) = blocking CI; draft and other branches = none;
# workflow_call changes no direct-run behavior and declares the optional
# cross-repo dependency-credential secret contract in workflow scope.
"on":
  workflow_dispatch:
  push:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
  pull_request:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
    types: [opened, synchronize, reopened, ready_for_review, edited]
  workflow_call:
    secrets:
      CI_DEPENDENCIES_APP_ID:
        required: false
        description: >-
          Optional cross-repo dependency GitHub App id; when absent the
          cross-repo credential step records NOT EXECUTED and public sibling
          dependencies resolve anonymously.
      CI_DEPENDENCIES_APP_PRIVATE_KEY:
        required: false
        description: >-
          Optional GitHub App private key minting the short-lived installation
          token for cross-repo private git dependencies.
# End SECTION: triggers

# Why: one active run per workflow and branch prevents obsolete CI from consuming runners.
# The event and PR number keep pull_request runs out of the integration push
# group: a PR event delivered after its merge resolves github.ref to the base
# branch and, keyed by ref alone, cancelled the post-merge run.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event_name }}-${{ (github.event_name == 'pull_request' && github.event.pull_request.number) || github.ref }}{% endraw %}
  cancel-in-progress: true

