name: CI

# === SECTION: triggers (managed) ===
# Source: CI policy — integration push/PR = blocking CI only;
# main push/PR (non-draft) = blocking CI; draft and other branches = none;
# workflow_call changes no direct-run behavior and declares the optional
# cross-repo dependency-credential secret contract in workflow scope.
"on":
  workflow_dispatch:
  push:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
  pull_request:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
    # No `edited`: a title edit must not cancel a running CI. The release
    # title guard reacts to edits in its own workflow (release-plan.yml).
    types: [opened, synchronize, reopened, ready_for_review]
  workflow_call:
    inputs:
      ref:
        description: Exact candidate commit to validate instead of the caller event SHA.
        required: false
        type: string
        default: ""
    secrets:
      CI_DEPENDENCIES_APP_ID:
        required: false
        description: >-
          Cross-repo dependency GitHub App id, required only by a repository
          that declares private dependencies; when it is absent there, the
          credential step records NOT EXECUTED and fails.
      CI_DEPENDENCIES_APP_PRIVATE_KEY:
        required: false
        description: >-
          Optional GitHub App private key minting the short-lived installation
          token for cross-repo private git dependencies.
# End SECTION: triggers

# Why: one active run per workflow and branch prevents obsolete CI from consuming runners.
# The event and PR number keep pull_request runs out of the integration push
# group: a PR event delivered after its merge resolves github.ref to the base
# branch and, keyed by ref alone, cancelled the post-merge run.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event_name }}-${{ inputs.ref || (github.event_name == 'pull_request' && github.event.pull_request.number) || github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  # === SECTION: ci job (managed) ===
  # Source: template + config:github_actions.*
  ci:
    name: ci
    # Only the checkout job needs repository contents; packages: read is
    # granted solely to distributions declared in codegen
    # ci_package_registry_read, whose gates resolve GitHub Packages.
    permissions:
      contents: read
{%- if packages_read %}
      packages: read
{%- endif %}
    if: {% raw %}${{ github.event_name != 'pull_request' || github.event.pull_request.draft == false }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
{%- if superproject %}
    defaults:
      run:
        working-directory: {{ superproject.path }}
{%- endif %}
    steps:
{%- if superproject %}
{{- superproject_checkout("inputs.ref || github.sha") }}
{%- else %}
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          submodules: {{ "false" if private_submodules or private_dependency_auth else checkout_submodules }}
{% if not private_submodules %}
          persist-credentials: false
{% endif %}
          fetch-depth: 0
          ref: {% raw %}${{ inputs.ref || github.sha }}{% endraw %}
{%- endif %}
{%- include "_fragments/private_submodules_init.j2" %}
{%- include "_fragments/private_dependency_auth.j2" %}
      # Why: GitHub runners expose umask 002, so git checkout materializes
      # group-writable modes (0664) for tracked files. Canonical Mise
      # artifacts demand exact modes (0o644) and the conform gate fails loud
      # on any drift, so checkout content is normalized to canonical modes
      # once, before any gate runs.
      - name: Normalize checkout modes
{%- if superproject %}
        working-directory: .
{%- endif %}
        run: chmod -R go-w .

      # Why: every fresh runner paid a cold full-dependency Mypy,
      # Pyrefly and Ruff analysis. The caches below are content-addressed by the
      # committed dependency locks, so a warm cache is always valid for the same
      # lock and can never hide a finding; it only removes the cold recompute.
      # Why: the same pair keeps the locked Mise tool storage, so
      # a cold runner never re-downloads the pinned tarballs, where a network
      # blip failed setup.
{%- include "_fragments/toolchain_cache_restore.j2" %}
      # Setup obtains any remaining declared members after authentication,
      # then installs the native shared workspace noneditable. It acquires Mise
      # officially and installs the toolchain and dependencies from their locks,
      # publishes that environment through GITHUB_PATH, and prepares the
      # project runtime. CI never runs `make upg`: it never re-resolves.
{%- if system_packages %}

      # Why: this repository's tests exercise a real external engine, and the
      # fleet declares such runner packages per distribution (codegen
      # ci_system_packages) instead of skipping the tests that need them.
      - name: Install declared system packages
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq --no-install-recommends {{ system_packages | join(" ") }}
{%- endif %}
{%- set ci_tests = namespace(selected=false) %}
{%- for step in make.workflow if step.verb == "tests" and "ci" in step.contexts %}
{%- set ci_tests.selected = true %}
{%- endfor %}
{%- if ci_tests.selected %}
{%- include "_fragments/testmon_cache_restore.j2" %}
{%- endif %}
{%- include "_fragments/custom_steps.j2" %}

{%- set ci_check = namespace(step_id="") %}
{%- for step in make.workflow if "ci" in step.contexts %}
{%- set verb = step.verb %}
{%- if verb == "check" %}
{%- set ci_check.step_id = "approval-" ~ step.identity %}
{%- endif %}
{%- set approval_id = "approval-" ~ step.identity %}
{%- if verb == "tests" %}
{%- set ci_tests.test_step_id = approval_id %}
{%- endif %}
      # CI approval, one visible step per ci workflow row ({{ make.approval_verbs | join(" -> ") }}).
      - name: {{ step.make_command }} (blocking)
        id: {{ approval_id }}
{%- if not loop.first %}
        # Every approval verb reports once setup provisioned the environment,
        # so one red verdict never hides the others; a declared requirement
        # (workflow requires) admits the step only after that verb is green.
        if: {% raw %}${{ !cancelled() && steps.{% endraw %}approval-{{ make.approval_verbs[0] }}{% raw %}.outcome == 'success'{% endraw %}{% for required in step.requires if "ci" in required.contexts %}{% raw %} && steps.{% endraw %}approval-{{ required.step }}{% raw %}.outcome == 'success'{% endraw %}{% endfor %}{% raw %} }}{% endraw %}
{%- endif %}
        run: {{ make.ci.variable }}={{ make.ci.value }} {{ step.make_command }}
{%- endfor %}
{%- include "_fragments/custom_post_steps.j2" %}
{%- if ci_tests.selected %}

      - name: Dump reports on failure
        if: {% raw %}${{ failure() }}{% endraw %}
        run: |
          set -eu
          # Structured reports only — a subset of Upload reports (no raw
          # pytest/tool logs: those may carry connection strings / env secrets).
          for report_root in .reports apps; do
            if [ -d "${report_root}" ]; then
              find "${report_root}" \
                \( -path '*/junit.xml' -o -path '*/coverage.xml' -o -path '*/coverage.json'{% for name in docs_report_filenames %} -o -path '*/{{ name }}'{% endfor %} \) \
                -type f -exec sh -eu -c '
                  for report_file do
                    printf "::group::%s\n" "${report_file}"
                    cat "${report_file}"
                    printf "::endgroup::\n"
                  done
                ' sh {} +
            fi
          done
{%- endif %}
      # Reports exist only once check executed; uploading after an earlier
      # failure would only add a second, misleading error.
      - name: Upload execution reports
        if: {% raw %}${{ !cancelled() && (steps.{% endraw %}{{ ci_check.step_id }}{% raw %}.outcome == 'success' || steps.{% endraw %}{{ ci_check.step_id }}{% raw %}.outcome == 'failure') }}{% endraw %}
        uses: {{ github_actions["upload-artifact"].repository }}@{{ github_actions["upload-artifact"].version }}
        with:
          name: flext-ci-reports-{% raw %}${{ github.run_id }}{% endraw %}
          # Structured reports only — omit raw pytest/tool logs that may carry
          # connection strings or env-derived secrets from integration fixtures.
          path: |
            {{ report_root }}.reports/**/junit.xml
            {{ report_root }}.reports/**/coverage.xml
            {{ report_root }}.reports/**/coverage.json
{% for name in docs_report_filenames %}            {{ report_root }}.reports/**/{{ name }}
{% endfor %}            {{ report_root }}.reports/check/**/*.sarif
            {{ report_root }}.reports/check/**/*.md
            {{ report_root }}{{ make.gate_receipts_directory }}/**/{{ gate_original_receipt_filename }}
            {{ report_root }}{{ make.gate_receipts_directory }}/**/check/**/*.sarif
            {{ report_root }}{{ make.gate_receipts_directory }}/**/check/**/*.md
            {{ report_root }}.reports/codegen-plan.json
            {{ report_root }}.reports/codegen-publication.json
            {{ report_root }}.reports/codegen-publication/**/*.json
            {{ report_root }}{{ setup_operations_report_directory }}/*.json
            {{ report_root }}.reports/tests/**/suite-outcome.json
            {{ report_root }}.reports/tests/**/selection-outcome.json
            {{ report_root }}.reports/tests/**/inventory-outcome.json
            {{ report_root }}.reports/tests/**/run-context.json
            {{ report_root }}.reports/tests/**/selection-plan.json
            {{ report_root }}.reports/tests/**/testmon-selection.json
            {{ report_root }}.reports/tests/**/testmon-inventory.json
            {{ report_root }}.reports/tests/**/run-accounting.json
            {{ report_root }}.reports/tests/**/diagnostics.json
            {{ report_root }}.reports/tests/**/{{ gate_original_receipt_filename }}
            {{ report_root }}.reports/tests/**/cache-before.json
            {{ report_root }}.reports/tests/**/cache-after.json
            {{ report_root }}.reports/tests/**/cache-policy.json
            {{ report_root }}.reports/tests/**/markdown-reconciliation.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 7
{%- set gate_receipts_step_id = ci_check.step_id %}
{%- include "_fragments/gate_receipts_upload.j2" %}
{%- if ci_tests.selected %}
{%- include "_fragments/testmon_cache_save.j2" %}
{%- endif %}

      # The lock-hash key is immutable: save only when the exact key missed,
      # after a failing gate as well, so the next run starts warm.
{%- include "_fragments/toolchain_cache_save.j2" %}
  # End SECTION: ci job
