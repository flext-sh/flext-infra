permissions:
  contents: read
# End SECTION: permissions

jobs:
  lane-policy:
    name: integration-lane-policy
    runs-on: ubuntu-latest
    steps:
      - name: Require typed integration lane
        run: |
          if [ "$GITHUB_HEAD_REF" != "{{ repository_branch }}" ]; then
            printf 'ERROR: PR head must be {{ repository_branch }}, got %s\n' "$GITHUB_HEAD_REF" >&2
            exit 2
          fi

  # === SECTION: ci job (managed) ===
  # Source: template + config:github_actions.*
  ci:
    name: ci
    needs: lane-policy
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].sha }}  # {{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          fetch-depth: 0

      - name: Install mise toolchain
        uses: {{ github_actions["mise"].repository }}@{{ github_actions["mise"].sha }}  # {{ github_actions["mise"].version }}

      - name: Install uv
        uses: {{ github_actions["setup-uv"].repository }}@{{ github_actions["setup-uv"].sha }}  # {{ github_actions["setup-uv"].version }}

{% for verb in make.lifecycle_verbs %}
