#!/usr/bin/env bash
# Owner-Skill: .agents/skills/scripts-validation/SKILL.md
# install-git-hooks.sh — Install the configured pre-commit framework stages at
# the workspace root.
#
# Usage:
#   make hooks
#   .github/scripts/install-git-hooks.sh [--verbose]

set -euo pipefail

VERBOSE="${1:-}"
WORKSPACE_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "${WORKSPACE_ROOT}"

_log() {
	if [[ "${VERBOSE}" == "--verbose" ]]; then
		echo "[INFO] $*"
	fi
}

fail() {
	printf 'install-git-hooks: %s\n' "$*" >&2
	exit 1
}

# Stage gates (operator law 2026-08-24): install only the stages the config
# SSOT enables (make.pre_commit / make.pre_push).
{% if make.pre_commit or make.pre_push %}
command -v pre-commit >/dev/null 2>&1 || fail "pre-commit is not installed; install it before provisioning hooks"

# The config is a codegen projection, so installing without it would leave a
# shim pointing at a file `make gen` never wrote.
[ -f "${WORKSPACE_ROOT}/.pre-commit-config.yaml" ] \
	|| fail ".pre-commit-config.yaml is missing; run 'make gen APPLY=Y' before provisioning hooks"

_log "Installing enabled git-hook stages at ${WORKSPACE_ROOT}"
pre-commit install{% if make.pre_commit %} -t pre-commit{% endif %}{% if make.pre_push %} -t pre-push{% endif %} >/dev/null \
	|| fail "pre-commit hook installation failed"
{% if make.pre_commit %}
[ -f "$(git rev-parse --git-path hooks/pre-commit)" ] \
	|| fail "pre-commit hook missing after provisioning"
{% endif %}
{% if make.pre_push %}
[ -f "$(git rev-parse --git-path hooks/pre-push)" ] \
	|| fail "pre-push hook missing after provisioning"
{% endif %}
echo "install-git-hooks: configured stages installed"
{% else %}
_log "Git-hook stages disabled by config gate; skipping pre-commit install"
echo "install-git-hooks: no stages enabled"
{% endif %}
