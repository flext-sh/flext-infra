#!/usr/bin/env bash
# Owner-Skill: .agents/skills/scripts-validation/SKILL.md
# install-git-hooks.sh — Install FLEXT's worktree-aware pre-commit hook and,
# for repositories that own a Beads ledger, preserve the chained Beads hooks.
#
# This generated script is the single owner of Git-hook provisioning. The
# pre-commit wrapper resolves the active checkout on every invocation, so a
# common Git directory shared by linked worktrees never persists the Python
# executable or configuration path from whichever worktree ran setup last.
#
# Usage:
#   make setup
#   .github/scripts/install-git-hooks.sh [--verbose]

set -euo pipefail

VERBOSE="${1:-}"
REPOSITORY_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" \
	|| { printf 'install-git-hooks: current directory is not a Git checkout\n' >&2; exit 1; }
cd "${REPOSITORY_ROOT}"

_log() {
	if [[ "${VERBOSE}" == "--verbose" ]]; then
		echo "[INFO] $*"
	fi
}

fail() {
	printf 'install-git-hooks: %s\n' "$*" >&2
	exit 1
}

runtime_python() {
	local superproject_root runtime_root
	superproject_root="$(git rev-parse --show-superproject-working-tree 2>/dev/null || true)"
	runtime_root="${superproject_root:-${REPOSITORY_ROOT}}"
	if [[ -x "${runtime_root}/.venv/bin/python" ]]; then
		printf '%s\n' "${runtime_root}/.venv/bin/python"
	elif [[ -x "${runtime_root}/.venv/Scripts/python.exe" ]]; then
		printf '%s\n' "${runtime_root}/.venv/Scripts/python.exe"
	else
		fail "managed environment missing for ${REPOSITORY_ROOT}; run: make -C \"${REPOSITORY_ROOT}\" setup"
	fi
}

{% if beads_enabled %}
command -v bd >/dev/null 2>&1 \
	|| fail "bd is not installed; install Beads before provisioning ledger hooks"

_log "Installing chained Beads hooks at ${REPOSITORY_ROOT}"
bd hooks install --chain >/dev/null || fail "bd hooks install --chain failed"

prepare_hook="$(git rev-parse --git-path hooks/prepare-commit-msg)"
[[ "${prepare_hook}" = /* ]] || prepare_hook="${REPOSITORY_ROOT}/${prepare_hook}"
[[ -f "${prepare_hook}" ]] \
	|| fail "prepare-commit-msg hook missing after bd hooks install"

_log "Applying the FLEXT agent-trailer guard to ${prepare_hook}"
GUARD_TOKEN="BD_ALLOW_AGENT_COMMIT_TRAILERS" "$(runtime_python)" \
	- "${prepare_hook}" <<'PY'
import os
import pathlib
import sys

token = os.environ["GUARD_TOKEN"]
path = pathlib.Path(sys.argv[1])
text = path.read_text()

if token in text:
    sys.exit(0)

guard = (
    "# --- BEGIN FLEXT AGENT-TRAILER GUARD ---\n"
    "# Managed by .github/scripts/install-git-hooks.sh — do not hand-edit.\n"
    "# FLEXT law (R5): prepare-commit-msg must NOT add agent attribution\n"
    "# trailers unless the user opts in with BD_ALLOW_AGENT_COMMIT_TRAILERS=1.\n"
    "# The Beads shim below only adds trailers, so gate it here.\n"
    'if [ "${BD_ALLOW_AGENT_COMMIT_TRAILERS:-0}" != "1" ]; then\n'
    "  exit 0\n"
    "fi\n"
    "# --- END FLEXT AGENT-TRAILER GUARD ---\n"
)

lines = text.splitlines(keepends=True)
marker = "# --- BEGIN BEADS INTEGRATION"
insert_at = next(
    (index for index, line in enumerate(lines) if line.startswith(marker)),
    None,
)
if insert_at is None:
    raise SystemExit(
        "beads integration marker not found; cannot place guard deterministically"
    )
lines[insert_at:insert_at] = [guard]
path.write_text("".join(lines))
PY

grep -q 'BD_ALLOW_AGENT_COMMIT_TRAILERS' "${prepare_hook}" \
	|| fail "guard token missing after injection"
grep -q 'bd hooks run prepare-commit-msg' "${prepare_hook}" \
	|| fail "bd delegation missing from prepare-commit-msg"
{% endif %}

pre_commit_hook="$(git rev-parse --git-path hooks/pre-commit)"
[[ "${pre_commit_hook}" = /* ]] \
	|| pre_commit_hook="${REPOSITORY_ROOT}/${pre_commit_hook}"
hook_dir="$(dirname "${pre_commit_hook}")"
mkdir -p "${hook_dir}"
hook_dir="$(cd "${hook_dir}" && pwd -P)"
legacy_hook="${pre_commit_hook}.legacy"
managed_marker="# FLEXT WORKTREE-AWARE PRE-COMMIT"

if [[ -e "${pre_commit_hook}" ]] \
	&& ! grep -qF "${managed_marker}" "${pre_commit_hook}" \
	&& ! grep -qF "File generated by pre-commit" "${pre_commit_hook}"; then
	if [[ ! -e "${legacy_hook}" ]]; then
		_log "Preserving the existing pre-commit hook as ${legacy_hook}"
		mv "${pre_commit_hook}" "${legacy_hook}"
	elif ! cmp -s "${pre_commit_hook}" "${legacy_hook}"; then
		fail "refusing to overwrite distinct legacy hook ${legacy_hook}"
	fi
fi

temporary_hook="$(mktemp "${hook_dir}/.pre-commit.flext.XXXXXX")"
cat >"${temporary_hook}" <<'HOOK'
#!/usr/bin/env sh
# FLEXT WORKTREE-AWARE PRE-COMMIT
# Generated by .github/scripts/install-git-hooks.sh — do not hand-edit.
set -eu

fail() {
	printf 'FLEXT pre-commit: %s\n' "$*" >&2
	exit 1
}

repository_root="$(git rev-parse --show-toplevel 2>/dev/null)" \
	|| fail "current directory is not a Git checkout"
superproject_root="$(git rev-parse --show-superproject-working-tree 2>/dev/null || true)"
runtime_root="${superproject_root:-${repository_root}}"

if [ -x "${runtime_root}/.venv/bin/python" ]; then
	runtime_python="${runtime_root}/.venv/bin/python"
elif [ -x "${runtime_root}/.venv/Scripts/python.exe" ]; then
	runtime_python="${runtime_root}/.venv/Scripts/python.exe"
else
	fail "managed environment missing for ${repository_root}; run: make -C \"${repository_root}\" setup"
fi

pre_commit_config="${repository_root}/{{ make.git_hooks.pre_commit_config }}"
[ -f "${pre_commit_config}" ] \
	|| fail "missing generated config ${pre_commit_config}; run: cd \"${repository_root}\" && {{ make.regeneration_command }}"
hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"

exec "${runtime_python}" -m pre_commit hook-impl \
	--config="${pre_commit_config}" \
	--hook-type=pre-commit \
	--hook-dir="${hook_dir}" -- "$@"
HOOK
chmod 0755 "${temporary_hook}"
mv "${temporary_hook}" "${pre_commit_hook}"

grep -qF "${managed_marker}" "${pre_commit_hook}" \
	|| fail "managed pre-commit marker missing after installation"
grep -q 'git rev-parse --show-toplevel' "${pre_commit_hook}" \
	|| fail "active-checkout resolution missing after installation"
if grep -q '^INSTALL_PYTHON=' "${pre_commit_hook}"; then
	fail "refusing to persist an installer-checkout Python path"
fi

echo "install-git-hooks: worktree-aware pre-commit hook installed"
