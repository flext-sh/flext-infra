# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
name: CI

"on":
  pull_request:
  push:
    branches:
      - {{ repository_branch }}
  workflow_dispatch:

permissions:
  contents: read

jobs:
  ci:
    name: ci
    runs-on: ubuntu-latest
    timeout-minutes: 120
    env:
      {{ make.ci.variable }}: {{ make.ci.value }}
    steps:
      - name: Checkout repository
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          fetch-depth: 0

{% for verb in make.approval_verbs %}
      - name: make {{ verb }}
        run: make {{ verb }}
{% endfor %}
