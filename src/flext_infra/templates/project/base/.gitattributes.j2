# Generated by flext-infra codegen; resolve source conflicts, then run make gen.
# Automatic text detection keeps binary contents unchanged.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# This control file uses ordinary text merging.
/.gitattributes text merge
# Full projections are regenerated, never combined with a textual merge.
{% for path in generated_paths %}
{{ path | tojson }} -merge linguist-generated
{% endfor %}
