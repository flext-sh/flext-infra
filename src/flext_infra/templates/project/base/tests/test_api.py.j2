    @staticmethod
    def test_ping_uses_injected_settings() -> None:
        """Independent runtime settings select their configured responses."""
        adjusted = settings.clone({{ ns }}={"enabled": not settings.{{ ns }}.enabled})
        for runtime in (settings, adjusted):
            service = {{ class_stem }}(
                configuration=config,
                runtime_options=runtime,
                runtime_settings=runtime,
            )
            result = tm.ok(service.ping(m.{{ ns }}.PingInput()))
            expected = (
                config.{{ ns }}.ping_reply
                if runtime.{{ ns }}.enabled
                else config.{{ ns }}.disabled_reply
            )
            tm.that(result.message, eq=expected)
            tm.ok(service.settings is runtime)
        tm.ok(settings.{{ ns }}.enabled != adjusted.{{ ns }}.enabled)
