{# NOTE (multi-agent): ordered workspace topology is the sole .gitmodules owner.
   Members are FLEXT-governed submodules only when config opts them into conform
   mutation. Content-only/read-only repositories remain real Git submodules but
   are explicitly non-managed so FLEXT tooling never mutates their checkouts. #}
{%- set submodules = workspace_repositories | list + (workspace_content_only | selectattr("checkout", "equalto", "submodule") | list) -%}
{% for repository in submodules %}[submodule "{{ repository.name }}"]
	path = {{ repository.path }}
	url = {{ repository.url }}
	branch = {{ repository.branch }}
	flext-classification = {{ repository.state }}
	flext-managed = {{ (repository.state == "active" and repository in workspace_repositories and not repository.read_only and repository.codegen == "conform") | lower }}{{ "\n\n" if not loop.last else "\n" }}{% endfor -%}
