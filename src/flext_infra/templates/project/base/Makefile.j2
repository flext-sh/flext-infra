# Read-only by contract in every profile: mutation belongs to `make fix
# APPLY=Y` / `make fmt APPLY=Y`, which run BEFORE check. CI={{ make.ci.value }}
# keeps make.ci.check_gates before orchestrating members (same contract as
# standalone/member Makefiles and flext_infra check run).
_builtin_check_all: _builtin_require_environment
	@if [ -n "$(strip $(APPLYING))" ]; then \
		printf 'ERROR: check is read-only; use `make fix APPLY=Y` / `make fmt APPLY=Y` first\n' >&2; exit 2; \
	fi
	@set -eu; \
	gates="$(strip $(CHECK_GATES))"; \
	if [ -z "$$gates" ]; then gates="$$(printf '%s' '$(CHECK_GATES_DEFAULT)' | tr ' ' ',')"; fi; \
	gates="$$(printf '%s' "$$gates" | tr -d '[:space:]')"; \
	if [ "$(strip $({{ make.ci.variable }}))" = "{{ make.ci.value }}" ]; then \
		filtered=""; \
		for gate in $$(printf '%s' "$$gates" | tr ',' ' '); do \
			keep=0; \
			{% for allowed in make.ci.check_gates -%}
			if [ "$$gate" = "{{ allowed }}" ]; then keep=1; fi; \
			{% endfor -%}
			if [ "$$keep" -eq 1 ]; then \
				if [ -n "$$filtered" ]; then filtered="$$filtered,$$gate"; else filtered="$$gate"; fi; \
			fi; \
		done; \
		gates="$$filtered"; \
		printf 'INFO: {{ make.ci.variable }}={{ make.ci.value }} runs check gates:{% for allowed in make.ci.check_gates %} {{ allowed }}{% endfor %}\n'; \
	fi; \
	if [ -z "$$gates" ]; then \
		printf 'ERROR: no check gates remain after {{ make.ci.variable }}={{ make.ci.value }} filtering\n' >&2; \
		exit 2; \
	fi; \
	$(WORKSPACE_ORCHESTRATE) --verb check $(WORKSPACE_PROJECT_ARGS) --make-arg "CHECK_GATES=$$gates" $(if $(filter 1,$(FAIL_FAST)),--fail-fast)

