{% endif %}
{% endfor %}{% for verb in extra_verbs %}
	@printf '  %-10s WHAT=%s{% if verb.apply_guarded or verb.accepts_apply %} APPLY=Y{% endif %}\n' '{{ verb.name }}' '{{ verb.default_what }}';
{% endfor %}
	@printf '  %-10s %s\n' 'WORKSPACE' 'target repository (default: current project)';
	@printf '  %-10s %s\n' 'PROJECT' 'member checkout for work when WORKSPACE unset';
