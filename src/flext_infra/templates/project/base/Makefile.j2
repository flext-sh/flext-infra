# filename-list functions split whitespace inside a legitimate physical path.
override SELF_MAKEFILE := $(shell {{ physical_file_reader('"$(MAKEFILE_LIST)"', true) }})
ifneq ($(.SHELLSTATUS),0)
$(error Cannot authenticate selected Makefile: $(MAKEFILE_LIST))
endif
