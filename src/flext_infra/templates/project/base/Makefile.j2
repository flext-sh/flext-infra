{% endfor %}{% for verb in extra_verbs %}	@printf '  %-16s %s{% if verb.requires_apply %} ({{ make.apply_variable }}={{ make.apply_value }}){% endif %}\n' '{{ verb.name }}' '{{ verb.description }}';
