{# ---- Shared command bases --------------------------------------------------
   Every verb states only its delta (which gate list, which mode); the checker
   invocation, the CI gate filter, the empty-gates guard, and the fmt/fix
   bodies are each rendered from ONE definition so no verb or profile can
   drift from another. #}
{%- macro gates_csv(names) -%}{{ names|join(",") }}{%- endmacro -%}
{%- macro gates_banner(names) -%}{{ names|join(" ") }}{%- endmacro -%}
{%- macro custom_reference_count(reference) -%}
$(shell awk -v reference="{{ reference }}" 'index($$0, reference) { count++ } END { print count + 0 }' "$(CUSTOM_MAKEFILE)")
{%- endmacro -%}
{%- macro check_run(gates, extra="") -%}$(PROJECT_FLEXT_INFRA) check run --repository-root "$(PROJECT_ROOT)" --gates "{{ gates }}"{{ extra }}{%- endmacro -%}
{%- macro local_check_body() -%}
{{ "\t" }}@set -eu; \
		gates="{{ gates_csv(make.check_gates_default) }}"; \
		if [ "$(strip $({{ make.ci.variable }}))" = "{{ make.ci.value }}" ]; then \
			gates="{{ gates_csv(make.check_gates_ci) }}"; \
			printf 'INFO: {{ make.ci.variable }}={{ make.ci.value }} runs check gates: {{ gates_banner(make.check_gates_ci) }}\n'; \
		elif [ "$(strip $({{ make.ci.variable }}))" = "{{ make.ci.local_value }}" ]; then \
			gates="{{ gates_csv(make.check_gates_local) }}"; \
			printf 'INFO: {{ make.ci.variable }}={{ make.ci.local_value }} runs check gates: {{ gates_banner(make.check_gates_local) }}\n'; \
		else \
			printf 'INFO: default context runs check gates: {{ gates_banner(make.check_gates_default) }}\n'; \
		fi; \
		if [ -z "$$gates" ]; then \
			printf 'ERROR: no active check gates remain in the selected context\n' >&2; \
			exit 2; \
		fi; \
		$(PROJECT_FLEXT_INFRA) {{ workspace_cli_group }} capture-gate --repository-root "$(PROJECT_ROOT)" --gates "$$gates"; \
		$(PROJECT_FLEXT_INFRA) codegen conform --root "$(PROJECT_ROOT)" --scope self --mode check
{%- endmacro -%}
{%- macro fmt_body() -%}
{{ "\t" }}@{{ check_run(gates_csv(make.fmt_gates), " --apply") }}
{%- endmacro -%}
{%- macro fix_body() -%}
{{ "\t" }}@{{ check_run(gates_csv(make.check_gates_fixable), " --apply") }}
{{ "\t" }}@$(PROJECT_FLEXT_INFRA) docs fix --repository-root "$(PROJECT_ROOT)" --output-dir "{{ make.docs.reports_dir }}" --projects . --apply
{%- endmacro -%}
{#- A local workspace run carries a mutating verb to every governed member
    after the root settles itself: flext-infra runs each member's own verb
    serially in runtime dependency order. CI
    keeps every repository evaluating only itself, so the fan-out never
    renders a CI step and members render nothing. -#}
{%- macro fleet_fanout(verb) -%}
{%- if make_profile == "workspace" %}
ifneq ($({{ make.ci.variable }}),{{ make.ci.value }})
{{ "\t" }}@$(PROJECT_FLEXT_INFRA) {{ workspace_cli_group }} fleet --repository-root "$(PROJECT_ROOT)" --verb {{ verb }}
endif
{%- endif -%}
{%- endmacro -%}
{%- macro upg_mise_lock(root) -%}
env -u MISE_SYSTEM_CONFIG_FILE \
	MISE_CEILING_PATHS="$$(dirname "{{ root }}")" \
	MISE_CONFIG_DIR="{{ root }}/.mise" \
	MISE_GLOBAL_CONFIG_FILE="{{ root }}/.mise/config.toml" \
	MISE_SYSTEM_CONFIG_DIR="{{ root }}/.mise" \
	$(MISE) -C "{{ root }}" lock --bump
{%- endmacro -%}
{%- macro pytest_testmon_guard() -%}
set -eu; \
database="$(FLEXT_PYTEST_TESTMON_DATABASE)"; \
case "$$database" in /*) ;; *) printf 'ERROR: persistent testmon database requires XDG_CACHE_HOME or HOME\n' >&2; exit 2 ;; esac; \
case "$$database" in "$(PROJECT_ROOT)"/*) printf 'ERROR: persistent testmon database must be outside the checkout: %s\n' "$$database" >&2; exit 2 ;; esac; \
case "$$database" in "$${TMPDIR:-/tmp}"/*|/tmp/*) printf 'ERROR: persistent testmon database must not live under the temporary directory: %s\n' "$$database" >&2; exit 2 ;; esac; \
mkdir -p "$$(dirname "$$database")"; \
{%- endmacro -%}
{#- Every pytest-running verb owns its children's scratch: ONE transient
    sandbox per recipe shell under the declared scratch root
    (make.pytest_scratch: $HOME/.local/state/.flext-runtime<checkout>/scratch), exposed
    through the standard temp triplet and deleted when the shell exits. The
    verb DECLARES the scratch for the suite it starts instead of inheriting the
    caller's ambient /tmp (fleet repos reject a test scratch under /tmp;
    cosmos-charts CI run 37235165752 died in pytest_configure on exactly that)
    and never places it beside the checkout, which inside a workspace is the
    superproject's tree. One definition feeds every verb, so no pytest verb can
    drift back to an undeclared scratch. -#}
{%- macro pytest_scratch_root() -%}
scratch_root="$(FLEXT_PYTEST_SCRATCH_ROOT)"; \
case "$$scratch_root" in /*) ;; *) printf 'ERROR: pytest scratch root requires {{ make.pytest_scratch.user_home_environment_variable }}: %s\n' "$$scratch_root" >&2; exit 2 ;; esac; \
mkdir -p "$$scratch_root"; \
scratch="$$(mktemp -d "$$scratch_root/pytest.XXXXXX")"; \
trap 'find "$$scratch" -depth -delete' EXIT; \
mkdir -p "$$scratch/tmp"; \
scratch_tmp="$$(cd "$$scratch/tmp" && pwd -P)"; \
TMPDIR="$$scratch_tmp"; TMP="$$scratch_tmp"; TEMP="$$scratch_tmp"; \
export TMPDIR TMP TEMP; \
{%- endmacro -%}
{#- The complete applicable suite runs once against the persistent database. -#}
{%- macro pytest_test_runner() -%}
{{ pytest_testmon_guard() }}
{{ pytest_scratch_root() }}
unset FLEXT_PYTEST_TARGET_FILE; \
{{ make.testmon_cache.database_environment_variable }}="$$database" $(PROJECT_INFRA_RUN) -m flext_infra._pytest_entry full
{%- endmacro -%}
