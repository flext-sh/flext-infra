# Generated by `flext_infra codegen conform`.
# === SECTION: header (managed) ===
# Source: template (base/.mise.toml.j2)
# Free: no
# End SECTION: header
# NOTE: mise carries the Python runtime and native tools from the config SSOT.
# Python dependencies remain owned by uv.lock.

[settings]
# The lockfile is a generated, committed projection of immutable tool metadata.
lockfile = true

[tool_config]
locked = true

# === SECTION: tools (managed) ===
# Source: config:python_version plus latest native tool selectors
#         (kubectl_version, helm_version, kind_version, taplo_version, ast_grep_version,
#          gitleaks_version, scc_version, kubeconform_version, qlty_version,
#          beads (selector/version/prerelease), gascity (selector/version/prerelease))
[tools]
python = "{{ python_version }}"
uv = "{{ uv_version }}"
# Native toolchain (single source: Infra.codegen.toolchain in codegen.yaml).
kubectl = "{{ kubectl_version }}"
helm = "{{ helm_version }}"
kind = "{{ kind_version }}"
direnv = "{{ direnv_version }}"
taplo = "{{ taplo_version }}"
ast-grep = "{{ ast_grep_version }}"
gitleaks = "{{ gitleaks_version }}"
# scc (the loc-cap gate's code counter) ships no bare mise registry alias, so
# pin the aqua backend explicitly (matching the qlty selector below). Its
# aqua-registry entry carries an evergreen catch-all rule with real
# per-platform release assets, so it never falls back to a source build,
# which keeps the offline setup/gen/check/test path source-build-free.
"aqua:boyter/scc" = "{{ scc_version }}"
kubeconform = "{{ kubeconform_version }}"
# qlty ships no mise registry alias; the github backend selector is the only
# resolvable form (bare 'qlty' fails mise install: 'not found in registry').
# GitHub Artifact Attestations is an external-token capability and is not
# selected by setup/gen; the lock still authenticates the downloaded bytes by
# checksum without silently requiring a personal GitHub credential.
[tools."github:qltysh/qlty"]
version = "{{ qlty_version }}"
github_attestations = false
# Go runtime for the Go projects in this workspace.
go = "{{ go_version }}"
[tools."{{ beads.selector }}"]
version = "{{ beads.version }}"
prerelease = {{ "true" if beads.prerelease else "false" }}
github_attestations = false
[tools."{{ gascity.selector }}"]
version = "{{ gascity.version }}"
prerelease = {{ "true" if gascity.prerelease else "false" }}
github_attestations = false
# End SECTION: tools
