# NOTE: mise carries the Python runtime and native tools from the config SSOT.
# Python dependencies remain owned by uv.lock. Mise resolves every tool to the
# newest published release at setup time: the fleet runs unlocked and current.
# Never run `mise lock`. Never commit mise.lock.

{%- macro github_fork_tool(tool) %}
[tools."{{ tool.selector }}"]
{%- if tool.track == "branch" %}
version = "{{ tool.branch }}"
{%- else %}
version = "{{ tool.version }}"
prerelease = {{ "true" if tool.prerelease else "false" }}
{%- endif %}
github_attestations = {{ "true" if tool.github_attestations else "false" }}
{%- endmacro %}

# === SECTION: settings (managed) ===
# Source: config:codegen.toolchain.mise_lockfile / mise_locked
[settings]
lockfile = {{ "true" if mise_lockfile else "false" }}
locked = {{ "true" if mise_locked else "false" }}
[tool_config]
locked = {{ "true" if mise_locked else "false" }}
# End SECTION: settings

# === SECTION: tools (managed) ===
# Source: config:python_version, config:codegen.scaffold.project.dev native toolchain floors
#         (kubectl_version, helm_version, kind_version, taplo_version, ast_grep_version,
#          gitleaks_version, scc_selector/scc_version, kubeconform_version, qlty_selector/qlty_version,
#          node_version, jscpd_selector/jscpd_version, waza_selector/waza_version,
#          beads (selector/track/version/prerelease/branch){{ ", gascity (selector/track/version/prerelease/branch)" if gascity_enabled else "" }})
[tools]
python = "{{ python_version }}"
uv = "{{ uv_version }}"
# Native toolchain (single source: Infra.codegen.toolchain in codegen.yaml).
kubectl = "{{ kubectl_version }}"
helm = "{{ helm_version }}"
kind = "{{ kind_version }}"
direnv = "{{ direnv_version }}"
taplo = "{{ taplo_version }}"
ast-grep = "{{ ast_grep_version }}"
gitleaks = "{{ gitleaks_version }}"
"{{ scc_selector }}" = "{{ scc_version }}"
kubeconform = "{{ kubeconform_version }}"
node = "{{ node_version }}"
"{{ jscpd_selector }}" = "{{ jscpd_version }}"
"{{ waza_selector }}" = "{{ waza_version }}"
go = "{{ go_version }}"
[tools."{{ qlty_selector }}"]
version = "{{ qlty_version }}"
github_attestations = false
{{ github_fork_tool(beads) }}
{%- if gascity_enabled %}
{{ github_fork_tool(gascity) }}
{%- endif %}
# End SECTION: tools
