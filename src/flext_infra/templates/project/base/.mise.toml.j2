# NOTE: mise carries itself, the Python runtime and the native tools from the
# config SSOT. The official installer supplies the acquisition executable; native
# `mise install` provisions the declared self entry and tools.
# Later execution resolves that entry through native Mise. Python dependency
# declarations remain owned by pyproject.toml. Tools are declared `latest`;
# only `make upg` bumps them (`mise lock --bump`) and writes the committed
# mise.lock. Setup always bootstraps: `mise install` honors every locked entry
# and records any entry the lock is missing, so lock drift never blocks setup.

# === SECTION: settings (managed) ===
# Source: config:codegen.toolchain.mise_lockfile / mise_lockfile_platforms /
#         dependency_cooldown_days (one fleet supply-chain cooldown, operator 2026-10-01)
[settings]
minimum_release_age = "{{ dependency_cooldown_days }}d"
lockfile = {{ "true" if mise_lockfile else "false" }}
# The mise release moves only through mise.lock (`make upg`); a newer release
# notice is not actionable here and only adds noise to every command.
disable_update_warning = {{ "true" if mise_disable_update_warning else "false" }}
# Native attestation absence is distinct from an API failure. API failures
# remain fatal; locked installs may reuse the existing lock and checksums.
provenance_api_failures_fatal = {{ "true" if mise_provenance_api_failures_fatal else "false" }}
locked_verify_provenance = {{ "true" if mise_locked_verify_provenance else "false" }}
lockfile_platforms = [{% for platform in mise_lockfile_platforms %}"{{ platform }}"{{ ", " if not loop.last }}{% endfor %}]
[settings.python]
compile = {{ "true" if python_compile else "false" }}
# End SECTION: settings

# === SECTION: tools (managed) ===
# Source: config:python_version + config:codegen.toolchain mise_selector /
#         mise_version (the self-managed mise entry) + toolchain.tools entries
#         (name, selector, version, version_prefix, form; entry order is the
#         projection order, form fixes the rendered shape)
[tools]
python = "{{ python_version }}"
# Mise interprets the self entry and its lock; Make never parses release assets.
"{{ mise_selector }}" = "{{ mise_version }}"
# Native toolchain (single source: Infra.codegen.toolchain.tools in codegen.yaml).
{%- macro tool_specifier(entry) -%}
{%- if entry.form == "table" or entry.bin or entry.http or entry.depends or entry.install_env or entry.postinstall -%}
{ version = {{ tool_versions[entry.name] | tojson }}
{%- if entry.version_prefix %}, version_prefix = {{ entry.version_prefix | tojson }}{%- endif -%}
{%- if entry.bin %}, bin = {{ entry.bin | tojson }}{%- endif -%}
{%- if entry.http -%}
{%- for option, value in entry.http.model_dump(exclude_none=true).items() %}, {{ option }} = {{ value | tojson }}{%- endfor -%}
{%- endif -%}
{%- if entry.depends %}, depends = {{ entry.depends | list | tojson }}{%- endif -%}
{%- if entry.install_env %}, install_env = { {% for key, value in entry.install_env.items() %}{{ key | tojson }} = {{ value | tojson }}{% if not loop.last %}, {% endif %}{% endfor %} }{%- endif -%}
{%- if entry.postinstall %}, postinstall = { run = {{ entry.postinstall.run | tojson }}{% if entry.postinstall.when %}, when = {{ entry.postinstall.when | tojson }}{% endif %} }{%- endif %} }
{%- else -%}
{{ tool_versions[entry.name] | tojson }}
{%- endif -%}
{%- endmacro -%}
{%- for entry in tools %}
{{ (entry.selector or entry.name) | tojson }} = {{ tool_specifier(entry) }}
{%- endfor %}
# End SECTION: tools
