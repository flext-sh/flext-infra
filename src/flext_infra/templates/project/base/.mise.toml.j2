# Generated by `flext-infra codegen conform`.
# NOTE: mise carries the Python runtime and native tools from the config SSOT.
# Python dependencies and uv are resolved by the caller-provided environment.

[tools]
python = "{{ python_version }}"
# uv is bootstrapped by CI/Dockerfiles; mise pins the exact version used
# during project setup so local and clean-machine environments agree.
uv = "{{ uv_version }}"
# Native toolchain (single source: Infra.codegen.toolchain in codegen.yaml).
kubectl = "{{ kubectl_version }}"
helm = "{{ helm_version }}"
kind = "{{ kind_version }}"
taplo = "{{ taplo_version }}"
ast-grep = "{{ ast_grep_version }}"
gitleaks = "{{ gitleaks_version }}"
tokei = "{{ tokei_version }}"
"{{ beads.selector }}" = "{{ beads.version }}"
