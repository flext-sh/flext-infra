# Generated by `flext-infra codegen conform`.
# === SECTION: Gas City Beads activation (managed) ===
# Source: BeadsWorkspaceEnvironmentSpec and Gas City runtime publication.
# The city owns the server; this repository retains its database identity.
{% if gascity %}
{% for source in gascity.environment_sources %}
source_env_if_exists "{{ source }}"
{% endfor %}
{% for var in gascity.unset_vars %}
unset {{ var }}
{% endfor %}
if [[ -v {{ gascity.identity_var }} ]] && [[ -n "${{ gascity.identity_var }}" ]]; then
  gas_city_root="$(cd "${{ gascity.identity_var }}" && pwd -P)"
  watch_file "${PROJECT_ROOT}/{{ gascity.beads_metadata_relpath }}"
  watch_file "${gas_city_root}/{{ gascity.city_state_relpath }}"
  BEADS_DOLT_SERVER_PORT="$(
    jq -er 'if .running == true and (.port | type == "number") and .port > 0 then
      .port
    else
      error("Gas City managed Dolt state is not healthy")
    end' "${gas_city_root}/{{ gascity.city_state_relpath }}"
  )"
  BEADS_DOLT_SERVER_DATABASE="$(
    jq -er 'if .dolt_mode == "server" and (.dolt_database | type == "string") and .dolt_database != "" then
      .dolt_database
    else
      error("Gas City must register this repository with a server database identity")
    end' "${PROJECT_ROOT}/{{ gascity.beads_metadata_relpath }}"
  )"
  export BEADS_DOLT_SERVER_HOST=127.0.0.1
  export BEADS_DOLT_SERVER_PORT BEADS_DOLT_SERVER_DATABASE
  export BEADS_DOLT_AUTO_START=0
fi
{% endif %}
# End SECTION: Gas City Beads activation
