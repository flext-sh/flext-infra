# @flext-managed: continuous
# @flext-regenerate: make gen WHAT=apply APPLY=Y
# @flext-ssot: config/beads.yaml + config/codegen.yaml
# @flext-maintenance: do not edit generated projections; edit the SSOT and regenerate
# Generated by `flext-infra gen conform`.
# Source: repository-local identity plus the fleet endpoint in config/codegen.yaml.
# Repository-local projection; conform only renders configuration and never
# initializes, starts, or verifies runtime state.
issue-prefix: {{ issue_prefix | tojson }}

dolt:
  mode: server
  shared-server: false
  host: {{ endpoint.host }}
  port: {{ endpoint.port }}
  user: root
  database: {{ database }}
  auto-commit: "on"
prefix: {{ database | tojson }}
