# @flext-managed: continuous
# @flext-regenerate: make gen WHAT=apply APPLY=Y
# @flext-ssot: flext-infra config/codegen.yaml (toolchain.beads.server)
# @flext-maintenance: do not edit generated projections; edit the SSOT and regenerate
# Generated by `flext-infra gen conform`.
# Source: issue-prefix and database derived from project identity.
# Source: dolt server block = flext-infra config/codegen.yaml
# toolchain.beads.server (machine-wide shared Dolt server facts).
{% if routing -%}
# Routing-only client config: this attached standalone owns no tracker state;
# bd commands route to the shared ledger below. Local data is never written.
{% else -%}
# Owned ledger config: the workspace root owns this tracker; conform
# initializes and verifies it against the pinned binary.
{% endif -%}
issue-prefix: {{ issue_prefix | tojson }}

# Dolt server connection (Gas Town town server on :{{ server.port }}).
# The `{{ database }}` database lives there; a repository-local server is never used.
dolt:
  mode: {{ server.mode }}
  shared-server: {{ server.shared_server | default(false) | tojson }}
  host: {{ server.host }}
  port: {{ server.port }}
  user: {{ server.user }}
  database: {{ database }}
  auto-commit: {{ server.auto_commit | default('on') | tojson }}
{% if not routing -%}
prefix: {{ database | tojson }}
{% if server.idle_timeout is defined -%}
dolt.idle-timeout: {{ server.idle_timeout | tojson }}
{% endif -%}
{% if server.export_auto is defined -%}
export.auto: {{ server.export_auto | tojson }}
{% endif -%}
{% if server.types_custom is defined -%}
types.custom: {{ server.types_custom | tojson }}
{% endif -%}
{% if server.types_infra is defined -%}
types.infra: {{ server.types_infra | tojson }}
{% endif -%}
{% endif -%}
