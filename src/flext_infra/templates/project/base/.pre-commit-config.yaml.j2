      # the full set with CI={{ make.ci.local_value }}, the local arm of the same
      # ternary: only the exact value {{ make.ci.value }} disables coverage and
      # narrows CHECK_GATES, so {{ make.ci.local_value }} keeps every gate and the
      # complete pytest+coverage run.
