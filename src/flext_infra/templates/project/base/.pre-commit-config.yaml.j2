        name: make {{ step.verb }}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %}
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset $(git rev-parse --local-env-vars); unset MAKEFLAGS {{ make.apply_variable }}; {{ make.ci.variable }}={{ make.ci.value }} make {{ step.verb }}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %}'
        pass_filenames: false
        always_run: true
        stages: [pre-commit]
{% endfor %}
{% endif -%}
{% if make.pre_push %}
{% for step in make.workflow if "pre_push" in step.contexts %}
