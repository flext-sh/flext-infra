{% macro workflow_hook(step, context) %}
      - id: flext-{{ context | replace("_", "-") }}-{{ step.identity }}
        name: {{ step.make_command }}
        language: system
{% if context == "pre_commit" and step.verb == "check" %}
        # A commit validates what it commits: lint/format run on the staged
        # files only; Markdown gates stay repo-wide because they are cheap and
        # generated projections must be checked as a whole. Pre-push keeps the
        # complete declared verbs.
        entry: >-
          bash -eu -o pipefail -c 'unset $(git rev-parse --local-env-vars); unset MAKEFLAGS; FLEXT=${FLEXT_INFRA_BIN:-$(command -v flext-infra || true)}; [ -n "$FLEXT" ] || FLEXT=./.venv/bin/flext-infra; args=(); md=(); argc=0; md_count=0; for f in "$@"; do case "$f" in /*) continue;; esac; [ -f "$f" ] && [ ! -L "$f" ] || continue; case "$f" in *.py) args+=(--file "$f"); argc=$((argc+1));; *.md) md+=("$f"); md_count=$((md_count+1));; esac; done; if [ "$argc" -gt 0 ]; then CI=C "$FLEXT" check run --repository-root . "${args[@]}" --gates lint --gates format; fi; if [ "$md_count" -gt 0 ]; then RUMDL=./.venv/bin/rumdl; [ -x "$RUMDL" ] || RUMDL=rumdl; "$RUMDL" check --config .rumdl.toml "${md[@]}"; "$RUMDL" fmt --check --config .rumdl.toml "${md[@]}"; fi; git diff --cached --check' --
        pass_filenames: true
{% else %}
        entry: >-
          bash -eu -o pipefail -c 'unset $(git rev-parse --local-env-vars); unset MAKEFLAGS; {% if context == "pre_commit" %}{{ make.ci.variable }}={{ make.ci.pre_commit_value }} {% elif step.verb == "check" %}unset {{ make.ci.variable }}; {% else %}{{ make.ci.variable }}={{ make.ci.local_value }} {% endif %}{{ step.make_command }}'
        pass_filenames: false
        always_run: true
        stages: [{{ context | replace("_", "-") }}]
{% endif %}
{%- endmacro %}
# Generated by flext_infra codegen for {{ dist }} — DO NOT EDIT
repos:
  - repo: local
    hooks:
    # Each hook invokes its declared public operation once. The commit row
    # passes make.ci.pre_commit_value, so check runs only the fast
    # commit-stage gates; pre-push rows run their complete declared verbs.
{% for context, enabled in (("pre_commit", make.pre_commit), ("pre_push", make.pre_push)) if enabled %}
{% for step in make.workflow if context in step.contexts %}
{{ workflow_hook(step, context) }}
{% endfor -%}{% endfor -%}
