{#- Make runs without Git's hook-local variables (GIT_DIR, GIT_INDEX_FILE, ...),
    so no verb acts on another repository. A commit row then stages the regular
    tracked files its verb changed, never a gitlink, into the index Git handed
    the hook: `git commit -a` and `git commit <path>` commit a temporary one. -#}
{% macro workflow_hook(step, context) %}
      - id: flext-{{ context | replace("_", "-") }}-{{ step.identity }}
        name: {{ step.make_command }}
        language: system
        entry: >-
          bash -eu -o pipefail -c '{% if context == "pre_commit" %}index=${GIT_INDEX_FILE-}; {% endif %}unset $(git rev-parse --local-env-vars); unset MAKEFLAGS; {% if context == "pre_commit" %}{{ make.ci.variable }}={{ make.ci.pre_commit_value }} {% elif step.verb == "check" %}unset {{ make.ci.variable }}; {% else %}{{ make.ci.variable }}={{ make.ci.local_value }} {% endif %}{{ step.make_command }}{% if context == "pre_commit" %}; git diff --name-only -z --ignore-submodules=all | GIT_INDEX_FILE=${index:-$(git rev-parse --git-path index)} xargs -0 -r git add --{% endif %}'
        pass_filenames: false
        always_run: true
        stages: [{{ context | replace("_", "-") }}]
{%- endmacro %}
# Generated by flext_infra codegen for {{ dist }} — DO NOT EDIT
repos:
  - repo: local
    hooks:
    # Each hook invokes its declared public operation once; the commit rows
    # are the CI rows, and each stages the tracked files its verb changed.
{% for context, enabled in (("pre_commit", make.pre_commit), ("pre_push", make.pre_push)) if enabled %}
{% for step in make.workflow if context in step.contexts %}
{{ workflow_hook(step, context) -}}
{% endfor -%}
{% if context == "pre_commit" %}

      # Native Git check of what is being committed: whitespace errors and
      # conflict markers, once, after the rows staged their repairs.
      - id: flext-pre-commit-whitespace
        name: git diff --cached --check
        language: system
        entry: git diff --cached --check
        pass_filenames: false
        always_run: true
        stages: [pre-commit]
{%- endif -%}
{%- endfor -%}
