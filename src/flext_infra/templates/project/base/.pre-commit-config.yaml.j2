repos:
  - repo: local
    hooks:
      # Why: each make verb is its own pre-commit/pre-push hook so the operator
      # sees per-step status (Passed/Failed) natively via the pre-commit runner.
      # CI={{ make.ci.value }} is injected for the pre-commit check hook only:
      # it runs the positive gate set (mypy/pyright/security/markdown/smells)
      # while skipping ruff/pyrefly/pytest — those run in pre-push and CI.
      # Pre-push check runs WITHOUT CI={{ make.ci.value }} so ALL gates block the push.
      # A step declaring gates_skip (mro-ucxgl) narrows CHECK_GATES for the hook
      # context only: local `make check` and the `docs` verb keep the full set.
{% for step in make.workflow if "pre_commit" in step.contexts %}
      - id: flext-pre-commit-{{ step.verb }}{% if step.what %}-{{ step.what }}{% endif %}
        name: make {{ step.verb }}{% if step.what %} WHAT={{ step.what }}{% endif %}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %}
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset $(git rev-parse --local-env-vars); {% if step.verb == "check" %}{{ make.ci.variable }}={{ make.ci.value }} {% endif %}{% if step.gates_skip %}CHECK_GATES={% for gate in make.check_gates_default if gate not in step.gates_skip %}{{ gate }}{% if not loop.last %},{% endif %}{% endfor %} {% endif %}make {{ step.verb }}{% if step.what %} WHAT={{ step.what }}{% endif %}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %}'
        pass_filenames: false
        always_run: true
        stages: [pre-commit]
{% endfor %}
{% for step in make.workflow if "pre_push" in step.contexts %}
      - id: flext-pre-push-{{ step.verb }}{% if step.what %}-{{ step.what }}{% endif %}
        name: make {{ step.verb }}{% if step.what %} WHAT={{ step.what }}{% endif %}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %}
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset $(git rev-parse --local-env-vars); {% if step.gates_skip %}CHECK_GATES={% for gate in make.check_gates_default if gate not in step.gates_skip %}{{ gate }}{% if not loop.last %},{% endif %}{% endfor %} {% endif %}make {{ step.verb }}{% if step.what %} WHAT={{ step.what }}{% endif %}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %}'
        pass_filenames: false
        always_run: true
        stages: [pre-push]
{% endfor %}
