# Generated by flext_infra codegen for {{ dist }} — DO NOT EDIT
fail_fast: true
repos:
  - repo: local
    hooks:
    # AI Hub owns installation and rejects partial staging before invoking
    # the runner with --all-files. Never stash or automatically stage repairs.
    # Keep Git's candidate index and clear CI to execute every local gate.
    # Complete each repair sequence before rejecting changed content.
{% if make.pre_commit %}
      - id: flext-pre-commit-candidate
        name: Validate complete commit candidate
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset MAKEFLAGS {{ make.ci.variable }}; git diff --quiet --ignore-submodules=none; test -z "$(git ls-files --others --exclude-standard)"; {% for step in make.workflow if "pre_commit" in step.contexts %}make {{ step.verb }}; {% endfor %}git diff --exit-code --ignore-submodules=none; test -z "$(git ls-files --others --exclude-standard)"'
        pass_filenames: false
        always_run: true
        stages: [pre-commit, pre-merge-commit]
{% endif -%}
{% if make.pre_push %}
      - id: flext-pre-push-candidate
        name: Validate published candidate
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset MAKEFLAGS {{ make.ci.variable }}; test -z "$(git status --porcelain --untracked-files=all --ignore-submodules=none)"; {% for step in make.workflow if "pre_push" in step.contexts %}make {{ step.verb }}; {% endfor %}test -z "$(git status --porcelain --untracked-files=all --ignore-submodules=none)"'
        pass_filenames: false
        always_run: true
        stages: [pre-push]
{% endif -%}
