        name: make {{ step.verb }}{% if step.what %} WHAT={{ step.what }}{% endif %}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %}
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset {{ make.hooks.clear_environment | join(" ") }}; {% if hook.clear_git_environment %}unset $(git rev-parse --local-env-vars); {% endif %}{{ make.ci.variable }}={{ hook.ci_value }} {% if step.gates_skip %}CHECK_GATES={% for gate in make.check_gates_default if gate not in step.gates_skip %}{{ gate }}{% if not loop.last %},{% endif %}{% endfor %} {% endif %}make {{ step.verb }}{% if step.what %} WHAT={{ step.what }}{% endif %}{% if step.apply %} {{ make.apply_variable }}={{ make.apply_value }}{% endif %}; local_hook="$(git rev-parse --git-path hooks/flext-{{ stage }}-{{ step.verb }}{% if step.what %}-{{ step.what }}{% endif %}{{ make.hooks.local_suffix }})"; [ ! -x "$local_hook" ] || "$local_hook"'
