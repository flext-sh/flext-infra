{#- The generated-file header is not rendered here: the pyproject projection
is a parse-merge-dump of this render and the live CUSTOM surface, which drops
every comment. Its composition owner (compose_project_artifact) prepends the
single header constant c.Infra.BANNER to the final projection. -#}
{#- A bare internal flext-* entry is only a floor name: it declares no Git
source, and conform fails loudly on source-less internal dependencies. The
scaffold seeds the source from the declared FLEXT dependency line; the
dependency lists are CUSTOM afterwards, so the declaration then rules. -#}
{%- macro flext_requirement(item) -%}
{%- set bare = item is string and item.startswith("flext-") and item.replace("-", "").replace("_", "").isalnum() -%}
{%- if bare -%}
"{{ item }} @ git+{{ flext_git_base_url }}/{{ item }}.git@{{ flext_git_branch }}"
{%- else -%}
{{ item | tojson }}
{%- endif -%}
{%- endmacro -%}

{%- macro hatch_target_declaration(target) -%}
[tool.hatch.build.targets.{{ target }}]
{% if packaged_data_excludes %}
exclude = [
{% for data_path in packaged_data_excludes %}
  {{ ("/" ~ data_path) | tojson }},
{% endfor %}
]
{% endif %}
only-include = [
  "src/{{ package_name }}",
{% for package in root_packages %}
  {{ ("src/" ~ package) | tojson }},
{% endfor %}
{% for data_path in packaged_data_paths if data_path not in packaged_data_files %}
  {{ data_path | tojson }},
{% endfor %}
{% for namespace in repository_namespace_packages %}
  {{ namespace | tojson }},
{% endfor %}
]
{%- endmacro -%}

# [MANAGED] build-system
[build-system]
build-backend = {{ scaffold.build.backend | tojson }}
requires = [
{% for item in scaffold.build.requirements %}
  {{ item | tojson }},
{% endfor %}
]

# [CUSTOM] name, description, authors, maintainers, scripts, entry-points, classifiers, keywords, license, urls, readme, version, dependencies, optional-dependencies
# [MANAGED] requires-python
# Runtime requirements retain the target's own declaration.
[project]
classifiers = [
{% for item in scaffold.project.classifiers %}
  {{ item | tojson }},
{% endfor %}
]
dependencies = [
{% for item in project_dependencies %}
  {{ flext_requirement(item) }},
{% endfor %}
]
description = "{{ description }}"
keywords = [
{% for item in scaffold.project.keywords %}
  {{ item | tojson }},
{% endfor %}
]
license = "{{ license }}"
name = "{{ dist }}"
readme = {{ scaffold.project.readme | tojson }}
requires-python = "{{ python_required_version }}"
version = "{{ version }}"

[[project.authors]]
email = "{{ author_email }}"
name = "{{ author_name }}"

[[project.maintainers]]
email = "{{ author_email }}"
name = "{{ author_name }}"

[dependency-groups]
dev = [
{% for item in development_dependencies %}
  {{ flext_requirement(item) }},
{% endfor %}
]
{% if cli_module %}
[project.scripts]
{{ dist }} = "{{ package_name }}.cli:{{ class_stem }}Cli.main"
{% endif %}
{% if repository %}

[project.urls]
Documentation = "{{ documentation }}"
Homepage = "{{ homepage }}"
Repository = "{{ repository }}"
{% endif %}

[tool.flext.docs]
package_name = {{ package_name | tojson }}

{% if make_profile == "workspace" and project_declaration_resource %}

[tool.hatch.build.targets.wheel.force-include]
{{ project_declaration_resource[0] | tojson }} = {{ project_declaration_resource[1] | tojson }}

[tool.hatch.build.targets.sdist.force-include]
{{ project_declaration_resource[0] | tojson }} = {{ project_declaration_resource[0] | tojson }}
{% endif %}
{% if make_profile != "workspace" %}
{% if hatch_build_hook_path %}

{# NOTE: emit only the project-owned declaration. #}
[tool.hatch.build.hooks.custom]
path = {{ hatch_build_hook_path | tojson }}
{% endif %}

{{ hatch_target_declaration("wheel") }}

[tool.hatch.build.targets.wheel.sources]
{{ ("src/" ~ package_name) | tojson }} = {{ package_name | tojson }}
{% for package in root_packages %}
{{ ("src/" ~ package) | tojson }} = {{ package | tojson }}
{% endfor %}
{% for data_path in packaged_data_paths if data_path not in packaged_data_files %}
{{ data_path | tojson }} = {{ (package_name ~ "/" ~ data_path) | tojson }}
{% endfor %}
{% for namespace in repository_namespace_packages %}
{{ namespace | tojson }} = {{ namespace | tojson }}
{% endfor %}
{% if packaged_data_files or root_modules or project_declaration_resource %}

[tool.hatch.build.targets.wheel.force-include]
{% if project_declaration_resource %}
{{ project_declaration_resource[0] | tojson }} = {{ project_declaration_resource[1] | tojson }}
{% endif %}
{% for data_dir in packaged_data_files if not project_declaration_resource or data_dir != project_declaration_resource[0] %}
{{ data_dir | tojson }} = {{ (package_name ~ "/" ~ data_dir) | tojson }}
{% endfor %}
{% for module in root_modules %}
{{ ("src/" ~ module ~ ".py") | tojson }} = {{ (module ~ ".py") | tojson }}
{% endfor %}
{% endif %}

{{ hatch_target_declaration("sdist") }}
{% if packaged_data_files or root_modules or hatch_build_hook_path or project_declaration_resource %}

[tool.hatch.build.targets.sdist.force-include]
{% if project_declaration_resource %}
{{ project_declaration_resource[0] | tojson }} = {{ project_declaration_resource[0] | tojson }}
{% endif %}
{% for data_file in packaged_data_files if not project_declaration_resource or data_file != project_declaration_resource[0] %}
{{ data_file | tojson }} = {{ data_file | tojson }}
{% endfor %}
{% for module in root_modules %}
{{ ("src/" ~ module ~ ".py") | tojson }} = {{ ("src/" ~ module ~ ".py") | tojson }}
{% endfor %}
{% if hatch_build_hook_path %}
{# uv 0.12 builds the wheel FROM the sdist: the declared custom hook must ride in it. Force-include keeps the wheel/sdist source patterns equal (release metadata contract). #}
{{ hatch_build_hook_path | tojson }} = {{ hatch_build_hook_path | tojson }}
{% endif %}
{% endif %}
{% endif %}

{{ tooling_runtime.configuration }}

# [MANAGED] tool.uv
[tool.uv]
link-mode = "{{ uv_link_mode }}"

# [MANAGED] tool.flext.namespace
{% if namespace_scan_dirs %}
[tool.flext.namespace]
# Production source roots the namespace validator enforces: tests host pytest
# conventions and scripts are thin command surfaces, so projects declare their
# production scope here.
scan_dirs = [{% for item in namespace_scan_dirs %}{{ item | tojson }}{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
