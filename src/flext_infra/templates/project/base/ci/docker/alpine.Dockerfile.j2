# Clean-machine proof: project bootstrap + canonical make verbs on Alpine
# (musl, POSIX /bin/sh at runtime; bash installed for the project scripts).
FROM alpine:3.21

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# === SECTION: base packages (managed) ===
# Source: template (distro-specific package list)
RUN apk add --no-cache \
      bash ca-certificates cargo curl git make build-base icu-dev icu-libs rust
# End SECTION: base packages

# === SECTION: managed tool bootstrap (managed) ===
# Source: config:mise_version, template (official release asset + uv installer)
RUN curl -fsSL \
      "https://github.com/jdx/mise/releases/download/v{{ mise_version }}/mise-v{{ mise_version }}-linux-x64-musl" \
      -o /usr/local/bin/mise \
    && chmod +x /usr/local/bin/mise \
    && test "$(mise --version | cut -d ' ' -f 1)" = "{{ mise_version }}"
# uv is intentionally supplied by the caller environment; install it explicitly
# in clean-machine images so the project bootstrap can resolve dependencies.
RUN curl -fsSL https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:/root/.local/share/mise/shims:${PATH}"
# End SECTION: managed tool bootstrap

WORKDIR /workspace
COPY . .

# === SECTION: generic mise toolchain (managed) ===
# Source: generated .mise.toml without consumer-specific Git tools
RUN mise trust .mise.toml && mise install --yes
# End SECTION: generic mise toolchain

# === SECTION: fail-closed bootstrap (managed) ===
# Source: canonical Make bootstrap
RUN make setup
# End SECTION: fail-closed bootstrap

ENTRYPOINT []
CMD ["/bin/bash", "-lc", "make help"]
