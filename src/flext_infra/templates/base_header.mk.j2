# =============================================================================
# FLEXT BASE MAKEFILE - Shared patterns for all FLEXT projects
# =============================================================================
# Usage: Set PROJECT_NAME before including: include ../base.mk
# Silent by default. Use VERBOSE=1 for detailed output.
# =============================================================================

# === CONFIGURATION (override before include) ===
PROJECT_NAME ?= {{ settings.project_name }}
PYTHON_VERSION ?= {{ settings.python_version }}
SRC_DIR ?= {{ settings.source_dir }}
TESTS_DIR ?= {{ settings.tests_dir }}
DOCSTRING_MIN ?= 80
COMPLEXITY_MAX ?= 10
{% for variable_name, default_value in make.PROJECT_VARIABLE_DEFAULTS -%}
{{ variable_name }} ?={% if default_value %} {{ default_value }}{% endif %}
{% endfor %}

PYTEST_REPORT_ARGS := -ra --durations=25 --durations-min=0.001 --tb=short
PYTEST_DIAG_ARGS := -rA --durations=0 --tb=long --showlocals
PYTEST_REPORTS_DIR ?= .reports/tests
override PYTEST_CASE_TIMEOUT_SECONDS := {{ pytest.case_timeout_seconds }}
override PYTEST_RUN_TIMEOUT_SECONDS := {{ pytest.run_timeout_seconds }}
override PYTEST_TERMINATION_GRACE_SECONDS := {{ pytest.termination_grace_seconds }}
override PYTEST_TIMEOUT_EXIT_CODE := {{ process_timeout_exit_code }}
override PYTEST_PROGRESS_ARGS :={% for argument in pytest.progress_args %} {{ argument }}{% endfor %}
override PYTEST_ENFORCEMENT_PLUGIN := {{ pytest.enforcement_plugin }}
PYTEST_TIMEOUT_COMMAND := {{ timeout_command }}
override PYTEST_PARALLEL_WORKERS := {{ pytest.parallel_workers }}
override PYTEST_PARALLEL_DISTRIBUTION := {{ pytest.parallel_distribution }}
override PYTEST_PROFILE_SORT := {{ pytest.profile_sort }}
override PYTEST_PROFILE_LIMIT := {{ pytest.profile_limit }}
