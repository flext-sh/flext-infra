[build-system]
requires = {{ build.requirements | tojson }}
build-backend = {{ build.backend | tojson }}

[project]
name = {{ distribution | tojson }}
version = {{ version | tojson }}
requires-python = {{ python_required | tojson }}

[project.entry-points."flext.typing-stubs"]
{{ module | tojson }} = {{ module | tojson }}

[tool.hatch.build.targets.wheel]
packages = [{{ (module ~ "-stubs") | tojson }}]

[tool.flext.typing]
implementation = {{ runtime_requirement | tojson }}
