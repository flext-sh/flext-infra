{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flext-sh/flext-infra/schemas/topology-overlay.schema.json",
  "title": "FLEXT Git Topology Overlays",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Infra"
  ],
  "properties": {
    "Infra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology"
      ],
      "properties": {
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overlays"
          ],
          "properties": {
            "overlays": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/overlay"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "beads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "namespace": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "externalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "docs",
              "resource",
              "stub"
            ]
          },
          "default": []
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match"
      ],
      "properties": {
        "match": {
          "$ref": "#/$defs/name"
        },
        "identity": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "beads": {
          "$ref": "#/$defs/beads"
        },
        "external_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/externalRef"
          },
          "default": []
        }
      }
    }
  }
}
